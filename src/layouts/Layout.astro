---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Analytics from '../components/Analytics.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string | { src: string };
  imageAlt?: string;
  article?: {
    publishedTime: string;
    modifiedTime?: string;
    author: { name: string; url?: string };
    tags: string[];
    category?: string;
    faq?: { question: string; answer: string }[];
  };
  canonical?: string;
  robots?: string;
  postCategory?: string;
  postTitle?: string;
}

const { title, description, image, imageAlt, article, canonical, robots, postCategory, postTitle } =
  Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed" href="/rss.xml" />
    <!-- Inter di-self-host via @fontsource (lihat src/styles/global.css) —
         link & preconnect Google Fonts dihapus karena render-blocking. -->
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      article={article}
      canonical={canonical}
      robots={robots}
    />
    <Analytics />
  </head>
  <body class="bg-background text-gray-900 dark:bg-background-dark dark:text-gray-100">
    <Header />
    <Breadcrumbs postCategory={postCategory} postTitle={postTitle} />
    <slot />
    <Footer />
  </body>
</html>
