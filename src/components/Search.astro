<script src="/pagefind/pagefind.js" is:inline></script>

<div id="search">
  <label for="search-input" class="sr-only">Cari artikel</label>
  <input
    type="search"
    id="search-input"
    placeholder="Kata kunci, topik, atau judul…"
    autocomplete="off"
    class="w-full border-b-2 border-rule-strong bg-transparent py-3 font-serif text-2xl text-ink placeholder:text-ink-muted focus:border-cobalt focus:outline-none sm:text-3xl"
  />
  <p id="search-status" class="kicker mt-3 text-ink-muted" role="status" aria-live="polite">
    Ketik minimal dua huruf untuk mulai mencari.
  </p>
  <div
    id="search-results"
    class="[&_a]:block [&_a]:py-5 [&_h3]:font-serif [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:leading-tight [&_mark]:bg-cobalt-tint [&_mark]:px-0.5 [&_mark]:text-ink [&_p]:mt-1.5 [&_p]:text-sm [&_p]:leading-relaxed [&_p]:text-ink-muted mt-4 divide-y divide-rule"
  >
  </div>
</div>

<script>
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchResults = document.getElementById('search-results');
  const searchStatus = document.getElementById('search-status');

  type PagefindResult = {
    data: () => Promise<{ url: string; excerpt: string; meta: { title?: string } }>;
  };

  if (searchInput && searchResults && searchStatus) {
    searchResults.innerHTML =
      '<p class="py-6 text-sm leading-relaxed text-ink-muted">Hasil pencarian akan muncul di sini. Indeks dibangun saat situs diterbitkan.</p>';

    const setStatus = (message: string) => {
      searchStatus.textContent = message;
    };

    searchInput.addEventListener('input', async (event) => {
      const query = (event.target as HTMLInputElement).value.trim();

      if (query.length < 2) {
        searchResults.innerHTML =
          '<p class="py-6 text-sm leading-relaxed text-ink-muted">Hasil pencarian akan muncul di sini.</p>';
        setStatus('Ketik minimal dua huruf untuk mulai mencari.');
        return;
      }

      const pagefind = (
        window as unknown as {
          Pagefind?: { search: (q: string) => Promise<{ results: PagefindResult[] }> };
        }
      ).Pagefind;
      if (!pagefind) {
        setStatus('Pencarian belum tersedia di lingkungan pengembangan.');
        return;
      }

      setStatus('Mencari…');

      try {
        const search = await pagefind.search(query);

        if (search.results.length === 0) {
          searchResults.innerHTML = '';
          setStatus(`Tidak ada hasil untuk “${query}”.`);
          return;
        }

        searchResults.innerHTML = '';
        for (const result of search.results) {
          const data = await result.data();

          const link = document.createElement('a');
          link.href = data.url;
          link.className = 'group transition-colors hover:text-cobalt';

          const title = document.createElement('h3');
          title.textContent = data.meta.title ?? 'Tanpa judul';

          const excerpt = document.createElement('p');
          excerpt.innerHTML = data.excerpt;

          link.append(title, excerpt);
          searchResults.appendChild(link);
        }

        setStatus(`${search.results.length} hasil untuk “${query}”.`);
      } catch {
        setStatus('Pencarian gagal dimuat. Coba muat ulang halaman.');
      }
    });
  }
</script>

<!-- Prefill dari param ?q= — target SearchAction di JSON-LD WebSite
     (TEKAA-3 P1-9) mendarat sebagai pencarian yang benar-benar jalan. -->
<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    const q = new URLSearchParams(window.location.search).get('q');
    const input = document.getElementById('search-input');
    if (q && input) {
      input.value = q;
      input.dispatchEvent(new Event('input'));
    }
  });
</script>
