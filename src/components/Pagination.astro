---
interface Props {
  currentPage: number;
  totalPages: number;
  /** Basis URL halaman 1, kanonik ber-slash (mis. `/posts/`, `/tags/ai/`). */
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

// TEKAA-377: halaman 1 = baseUrl apa adanya (sudah ber-slash), halaman ≥2
// menambah satu segmen nomor. Tanpa `/` ganda dan tanpa bentuk tanpa-slash
// yang memicu 308 di Cloudflare Pages.
const pageUrl = (page: number): string => {
  if (page <= 1) return baseUrl;
  return `${baseUrl.replace(/\/+$/, '')}/${page}/`;
};

const prevPage = currentPage > 1 ? currentPage - 1 : null;
const nextPage = currentPage < totalPages ? currentPage + 1 : null;

// Generate page numbers to show
const getPageNumbers = () => {
  const pages = [];
  const maxVisible = 5;

  if (totalPages <= maxVisible) {
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    const start = Math.max(1, currentPage - 2);
    const end = Math.min(totalPages, start + maxVisible - 1);

    if (start > 1) {
      pages.push(1);
      if (start > 2) pages.push('...');
    }

    for (let i = start; i <= end; i++) {
      pages.push(i);
    }

    if (end < totalPages) {
      if (end < totalPages - 1) pages.push('...');
      pages.push(totalPages);
    }
  }

  return pages;
};

const pageNumbers = getPageNumbers();
---

{
  totalPages > 1 && (
    <nav class="mt-12 flex items-center justify-center space-x-2" aria-label="Pagination">
      {prevPage && (
        <a
          href={pageUrl(prevPage)}
          class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700"
        >
          Previous
        </a>
      )}

      {pageNumbers.map((page) =>
        page === '...' ? (
          <span class="px-4 py-2 text-sm font-medium text-gray-500">...</span>
        ) : page === currentPage ? (
          <span class="rounded-md border border-blue-600 bg-blue-600 px-4 py-2 text-sm font-medium text-white">
            {page}
          </span>
        ) : (
          <a
            href={pageUrl(page)}
            class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700"
          >
            {page}
          </a>
        )
      )}

      {nextPage && (
        <a
          href={pageUrl(nextPage)}
          class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-50 dark:border-gray-600 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-gray-700"
        >
          Next
        </a>
      )}
    </nav>
  )
}
