---
interface Props {
  currentPage: number;
  totalPages: number;
  /** Basis URL halaman 1, kanonik ber-slash (mis. `/posts/`, `/tags/ai/`). */
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

// TEKAA-377: halaman 1 = baseUrl apa adanya (sudah ber-slash), halaman ≥2
// menambah satu segmen nomor. Tanpa `/` ganda dan tanpa bentuk tanpa-slash
// yang memicu 308 di Cloudflare Pages.
const pageUrl = (page: number): string => {
  if (page <= 1) return baseUrl;
  return `${baseUrl.replace(/\/+$/, '')}/${page}/`;
};

const prevPage = currentPage > 1 ? currentPage - 1 : null;
const nextPage = currentPage < totalPages ? currentPage + 1 : null;

const getPageNumbers = () => {
  const pages: (number | '...')[] = [];
  const maxVisible = 5;

  if (totalPages <= maxVisible) {
    for (let i = 1; i <= totalPages; i++) {
      pages.push(i);
    }
  } else {
    const start = Math.max(1, currentPage - 2);
    const end = Math.min(totalPages, start + maxVisible - 1);

    if (start > 1) {
      pages.push(1);
      if (start > 2) pages.push('...');
    }

    for (let i = start; i <= end; i++) {
      pages.push(i);
    }

    if (end < totalPages) {
      if (end < totalPages - 1) pages.push('...');
      pages.push(totalPages);
    }
  }

  return pages;
};

const pageNumbers = getPageNumbers();
const itemClass =
  'kicker inline-flex min-h-11 min-w-11 items-center justify-center border border-rule px-3 py-2 text-ink-soft transition-colors hover:border-cobalt hover:text-cobalt';
---

{
  totalPages > 1 && (
    <nav
      class="mt-12 flex flex-wrap items-center justify-center gap-1.5 border-t-2 border-rule-strong pt-6"
      aria-label="Navigasi halaman"
    >
      {prevPage ? (
        <a href={pageUrl(prevPage)} class={itemClass} aria-label="Ke halaman sebelumnya">
          ← Sebelumnya
        </a>
      ) : (
        <span class={`${itemClass} cursor-not-allowed text-rule`} aria-hidden="true">
          ← Sebelumnya
        </span>
      )}

      {pageNumbers.map((page) =>
        page === '...' ? (
          <span class="px-2 text-ink-muted" aria-hidden="true">
            …
          </span>
        ) : page === currentPage ? (
          <span
            class="kicker min-h-11 min-w-11 inline-flex items-center justify-center border border-ink bg-ink px-3 py-2 text-paper-light"
            aria-current="page"
          >
            {page}
          </span>
        ) : (
          <a href={pageUrl(page)} class={itemClass} aria-label={`Ke halaman ${page}`}>
            {page}
          </a>
        )
      )}

      {nextPage ? (
        <a href={pageUrl(nextPage)} class={itemClass} aria-label="Ke halaman selanjutnya">
          Selanjutnya →
        </a>
      ) : (
        <span class={`${itemClass} cursor-not-allowed text-rule`} aria-hidden="true">
          Selanjutnya →
        </span>
      )}
    </nav>
  )
}
