---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getCategoryLabel, getCategorySlug, getCategoryUrl } from '../utils/categories';
import { getPostUrl } from '../utils/urls.mjs';
import { calculateReadingTime } from '../utils/readingTime';
import { coverAlt } from '../utils/coverAlt';
import { formatShortDate } from '../utils/edisi';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
  thumbnail?: boolean;
}

const { post, index, thumbnail = false } = Astro.props;
const category = getCategoryLabel(post.data.category);
const categorySlug = getCategorySlug(post.data.category);
const minutes = post.data.readingTime ?? calculateReadingTime(post.body);
const href = getPostUrl(post.slug);
---

<article
  class:list={[
    'group grid gap-3 border-t border-rule py-5 sm:gap-6',
    thumbnail ? 'sm:grid-cols-[7rem_1fr_10.5rem]' : 'sm:grid-cols-[8.5rem_1fr]',
  ]}
  data-article-topic={categorySlug}
>
  <div class="flex items-baseline gap-3 sm:block">
    {
      index !== undefined && (
        <span class="font-display text-lg leading-none text-cobalt">
          {String(index).padStart(2, '0')}
        </span>
      )
    }
    <a
      href={getCategoryUrl(post.data.category)}
      class="kicker text-ink-muted transition-colors hover:text-cobalt sm:mt-1 sm:block"
    >
      {category}
    </a>
  </div>

  <div>
    <h3 class="font-serif text-[1.35rem] font-semibold leading-[1.15] sm:text-2xl">
      <a href={href} class="transition-colors group-hover:text-cobalt">{post.data.title}</a>
    </h3>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted">{post.data.summary}</p>
    <p class="mt-2.5 text-xs text-ink-muted">
      {post.data.author}
      <span class="mx-1.5 text-rule">/</span>
      <time datetime={post.data.publishedAt.toISOString()}>
        {formatShortDate(post.data.publishedAt)}
      </time>
      <span class="mx-1.5 text-rule">/</span>
      {minutes} mnt baca
    </p>
  </div>

  {
    thumbnail && post.data.coverImage && (
      <a href={href} class="hidden self-start sm:block" tabindex="-1" aria-hidden="true">
        <Image
          src={post.data.coverImage}
          alt={coverAlt(post)}
          width={168}
          height={95}
          loading="lazy"
          class="h-[95px] w-[168px] object-cover"
        />
      </a>
    )
  }
</article>
