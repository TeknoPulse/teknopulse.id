---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ShareButtons from './ShareButtons.astro';
import GiscusComments from './GiscusComments.astro';
import { calculateReadingTime } from '../utils/readingTime';
import { getAuthor, getAuthorUrl } from '../utils/authors';
import { coverAlt } from '../utils/coverAlt';
import { getAllCategories, getCategoryLabel, getCategoryUrl } from '../utils/categories';
import { getPostUrl, getTagUrl, slugifyTag } from '../utils/urls.mjs';
import { hasManualSourcesSection, normalizeSources } from '../utils/sources';
import { formatDate, formatShortDate } from '../utils/edisi';

interface Props {
  post: CollectionEntry<'posts'>;
  relatedPosts: CollectionEntry<'posts'>[];
  categoryPosts: CollectionEntry<'posts'>[];
  ogImage?: CollectionEntry<'posts'>['data']['coverImage'] | string;
  preview?: boolean;
}

const { post, relatedPosts, categoryPosts, ogImage, preview = false } = Astro.props;

const { Content } = await post.render();

const readingTime = post.data.readingTime ?? calculateReadingTime(post.body);
const author = getAuthor(post.data.author);
const authorName = author?.name ?? post.data.author;

const description = post.data.metaDescription ?? post.data.summary;
const updated =
  post.data.updatedAt &&
  post.data.updatedAt.toISOString().slice(0, 10) !==
    post.data.publishedAt.toISOString().slice(0, 10)
    ? post.data.updatedAt
    : undefined;

const faq = post.data.faq ?? [];
const sources = normalizeSources(post.data.source);
const showSources = sources.length > 0 && !hasManualSourcesSection(post.body);
const tags = post.data.tags ?? [];

const category = getCategoryLabel(post.data.category);
const categoryUrl = getCategoryUrl(post.data.category);
const categories = getAllCategories().sort((a, b) => a.name.localeCompare(b.name));
---

<Layout
  title={preview ? `${post.data.title} (pratinjau) — TeknoPulse` : post.data.title}
  description={description}
  image={ogImage}
  imageAlt={post.data.title}
  article={preview
    ? undefined
    : {
        publishedTime: post.data.publishedAt.toISOString(),
        modifiedTime: post.data.updatedAt?.toISOString(),
        author: {
          name: authorName,
          url: author ? getAuthorUrl(author) : undefined,
        },
        tags: post.data.tags,
        category: post.data.category,
        faq,
        sources,
      }}
  robots={preview ? 'noindex, follow' : undefined}
  pagefindIgnore={preview}
  showBreadcrumbs={false}
  variant="real"
>
  <main>
    {
      !preview && (
        <Breadcrumbs
          postCategory={post.data.category}
          postTitle={post.data.title}
          showNav={false}
        />
      )
    }

    <article>
      <header class="border-b-2 border-rule-strong">
        <div class="wrap pt-8 pb-7 sm:pt-12">
          <nav
            aria-label="Remah roti"
            class="kicker flex flex-wrap items-center gap-2 text-ink-muted"
          >
            <a href="/" class="hover:text-cobalt">Beranda</a>
            <span aria-hidden="true" class="text-rule">/</span>
            <a href={categoryUrl} class="hover:text-cobalt">{category}</a>
            <span aria-hidden="true" class="hidden text-rule sm:inline">/</span>
            <span class="hidden text-ink-soft sm:inline">{post.data.title}</span>
          </nav>

          <p class="kicker mt-7 text-cobalt">
            {category}
            <span class="mx-2 text-rule">/</span>
            <time datetime={post.data.publishedAt.toISOString()}>
              {formatDate(post.data.publishedAt)}
            </time>
          </p>

          <h1
            class="headline-balance mt-3 max-w-5xl font-serif text-[clamp(2.4rem,5.6vw,4.6rem)] font-semibold leading-[0.94] tracking-headline"
          >
            {post.data.title}
          </h1>

          <p
            class="mt-5 max-w-3xl font-serif text-xl italic leading-snug text-ink-soft sm:text-2xl"
          >
            {description}
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 border-y border-rule py-3.5">
            <span class="kicker text-ink">
              Oleh
              {
                author ? (
                  <a href={getAuthorUrl(author)} class="font-semibold hover:text-cobalt">
                    {author.name}
                  </a>
                ) : (
                  <span class="font-semibold">{post.data.author}</span>
                )
              }
            </span>
            <time datetime={post.data.publishedAt.toISOString()} class="kicker text-ink-muted">
              {formatDate(post.data.publishedAt)}
            </time>
            {
              updated && (
                <span class="kicker text-ink-muted">
                  Diperbarui <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
                </span>
              )
            }
            <span class="kicker text-ink-muted">{readingTime} menit baca</span>
            {
              preview && (
                <span class="kicker border border-cobalt px-2 py-0.5 text-cobalt">Pratinjau</span>
              )
            }
          </div>
        </div>
      </header>

      {
        post.data.coverImage && (
          <figure class="wrap pt-8 sm:pt-10">
            <Image
              src={post.data.coverImage}
              alt={coverAlt(post)}
              width={1280}
              height={720}
              loading="eager"
              fetchpriority="high"
              class="aspect-[16/9] w-full object-cover"
            />
          </figure>
        )
      }

      <div class="wrap py-10 sm:py-14">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-0">
          <div class="lg:col-span-8 lg:pr-12">
            <div class="prose-news max-w-reading">
              <Content />
            </div>

            <ShareButtons title={post.data.title} url={getPostUrl(post.slug)} />

            {
              showSources && (
                <section class="mt-10 border-t border-rule pt-6" aria-labelledby="sumber-heading">
                  <h2 id="sumber-heading" class="font-serif text-2xl font-semibold">
                    Sumber
                  </h2>
                  <ul class="mt-4 divide-y divide-rule">
                    {sources.map((source) => (
                      <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 py-3 text-sm leading-relaxed">
                        {source.primary && (
                          <span class="kicker border border-cobalt px-1.5 py-0.5 text-cobalt">
                            Sumber primer
                          </span>
                        )}
                        <span class="text-ink">{source.name}</span>
                        <a
                          href={source.url}
                          target="_blank"
                          rel="noopener"
                          class="break-all text-cobalt underline decoration-rule underline-offset-4 hover:text-cobalt-dark"
                        >
                          {source.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </section>
              )
            }

            {
              faq.length > 0 && (
                <section class="mt-10 border-t border-rule pt-6" aria-labelledby="faq-heading">
                  <h2 id="faq-heading" class="font-serif text-2xl font-semibold">
                    Pertanyaan yang Sering Diajukan
                  </h2>
                  <div class="mt-2 divide-y divide-rule">
                    {faq.map((item) => (
                      <div class="py-5">
                        <h3 class="font-serif text-lg font-semibold leading-snug">
                          {item.question}
                        </h3>
                        <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.answer}</p>
                      </div>
                    ))}
                  </div>
                </section>
              )
            }
          </div>

          <aside class="lg:col-span-4 lg:border-l lg:border-rule lg:pl-10">
            <div class="lg:sticky lg:top-24">
              <section aria-labelledby="sekilas-artikel">
                <div class="flex items-baseline justify-between border-b-2 border-rule-strong pb-2">
                  <h2 id="sekilas-artikel" class="font-serif text-2xl font-semibold">Sekilas</h2>
                  <span class="kicker text-ink-muted">Artikel</span>
                </div>
                <dl class="divide-y divide-rule text-sm">
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Rubrik</dt>
                    <dd>
                      <a href={categoryUrl} class="text-cobalt hover:text-cobalt-dark">
                        {category}
                      </a>
                    </dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Penulis</dt>
                    <dd class="text-right text-ink">
                      {
                        author ? (
                          <a href={getAuthorUrl(author)} class="hover:text-cobalt">
                            {author.name}
                          </a>
                        ) : (
                          post.data.author
                        )
                      }
                    </dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Terbit</dt>
                    <dd class="text-right text-ink">
                      <time datetime={post.data.publishedAt.toISOString()}>
                        {formatDate(post.data.publishedAt)}
                      </time>
                    </dd>
                  </div>
                  {
                    updated && (
                      <div class="flex items-baseline justify-between gap-4 py-3">
                        <dt class="kicker text-ink-muted">Diperbarui</dt>
                        <dd class="text-right text-ink">
                          <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
                        </dd>
                      </div>
                    )
                  }
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Waktu baca</dt>
                    <dd class="text-right text-ink">{readingTime} menit</dd>
                  </div>
                </dl>
              </section>

              {
                tags.length > 0 && (
                  <section class="mt-8 border-t border-rule pt-5" aria-labelledby="tag-artikel">
                    <h2 id="tag-artikel" class="kicker text-ink-muted">
                      Tag
                    </h2>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {tags.map((tag) => (
                        <a
                          href={getTagUrl(slugifyTag(tag))}
                          class="kicker border border-rule px-2 py-1 text-ink-soft hover:border-cobalt hover:text-cobalt"
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  </section>
                )
              }

              {
                categoryPosts.length > 0 && (
                  <section class="mt-8 border-t border-rule pt-5" aria-labelledby="lain-rubrik">
                    <h2 id="lain-rubrik" class="kicker text-ink-muted">
                      Lain dari {category}
                    </h2>
                    <ul class="mt-2 divide-y divide-rule">
                      {categoryPosts.map((item) => (
                        <li class="py-3">
                          <a
                            href={getPostUrl(item.slug)}
                            class="font-serif text-[1.05rem] leading-snug hover:text-cobalt"
                          >
                            {item.data.title}
                          </a>
                          <p class="mt-1 text-xs text-ink-muted">
                            {formatShortDate(item.data.publishedAt)}
                          </p>
                        </li>
                      ))}
                    </ul>
                  </section>
                )
              }

              <section class="mt-8 border-t border-rule pt-5" aria-labelledby="jelajahi-rubrik">
                <h2 id="jelajahi-rubrik" class="kicker text-ink-muted">Jelajahi rubrik</h2>
                <div class="mt-3 flex flex-wrap gap-2">
                  {
                    categories.map((item) => (
                      <a
                        href={getCategoryUrl(item.name)}
                        class="kicker border border-rule px-2 py-1 text-ink-soft hover:border-cobalt hover:text-cobalt"
                      >
                        {item.name}
                      </a>
                    ))
                  }
                </div>
              </section>

              <p class="mt-8 border-l-2 border-cobalt pl-4 text-sm leading-relaxed text-ink-muted">
                {
                  preview
                    ? 'Pratinjau desain artikel dengan konten asli.'
                    : 'Menemukan kesalahan atau informasi yang sudah tidak relevan?'
                }
                <a href="/contact/" class="text-cobalt hover:text-cobalt-dark">
                  {' '}Hubungi redaksi →
                </a>
              </p>
            </div>
          </aside>
        </div>

        {
          relatedPosts.length > 0 && (
            <section class="mt-14 border-t-2 border-rule-strong pt-6" aria-labelledby="terkait">
              <div class="flex flex-wrap items-baseline justify-between gap-4">
                <h2 id="terkait" class="font-serif text-2xl font-semibold">
                  Artikel terkait
                </h2>
                <a href="/posts/" class="kicker text-cobalt hover:text-cobalt-dark">
                  Semua artikel →
                </a>
              </div>
              <div class="mt-5 grid gap-x-8 gap-y-7 sm:grid-cols-3">
                {relatedPosts.map((item) => (
                  <article class="group border-t border-rule pt-4">
                    {item.data.coverImage && (
                      <a
                        href={getPostUrl(item.slug)}
                        tabindex="-1"
                        aria-hidden="true"
                        class="block overflow-hidden"
                      >
                        <Image
                          src={item.data.coverImage}
                          alt={coverAlt(item)}
                          width={400}
                          height={225}
                          loading="lazy"
                          class="aspect-[16/9] w-full object-cover transition-opacity group-hover:opacity-90"
                        />
                      </a>
                    )}
                    <p class="kicker mt-3 text-cobalt">
                      {getCategoryLabel(item.data.category)}
                      <span class="mx-1.5 text-rule">/</span>
                      {formatShortDate(item.data.publishedAt)}
                    </p>
                    <h3 class="mt-2 font-serif text-xl font-semibold leading-tight">
                      <a
                        href={getPostUrl(item.slug)}
                        class="transition-colors group-hover:text-cobalt"
                      >
                        {item.data.title}
                      </a>
                    </h3>
                    <p class="line-clamp-3 mt-2 text-sm leading-relaxed text-ink-muted">
                      {item.data.summary}
                    </p>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        <div class="mt-14">
          <GiscusComments />
        </div>
      </div>
    </article>
  </main>
</Layout>
