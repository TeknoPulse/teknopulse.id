---
// Banner persetujuan cookie analitik (UU PDP) — follow-up TEKAA-48.
//
// GA4 (G-79X7QWV977) menaruh cookie _ga sehingga butuh persetujuan dulu.
// Logika skrip di bawah:
//   - belum ada keputusan → tampilkan banner, GA4 TIDAK dimuat sama sekali;
//   - "granted"           → muat gtag.js + bootstrap standar;
//   - "denied"            → GA4 tidak pernah dimuat, banner tidak muncul lagi.
// Cloudflare Web Analytics tidak lewat komponen ini — cookieless, tanpa consent.
// Keputusan disimpan di localStorage supaya banner tidak nag tiap kunjungan;
// pengunjung bisa menarik persetujuan dengan menghapus data situs di browser.
const GA4_MEASUREMENT_ID = 'G-79X7QWV977';
---

<div
  id="cookie-consent"
  hidden
  role="region"
  aria-label="Persetujuan cookie analitik"
  class="fixed inset-x-0 bottom-0 z-50 p-4"
>
  <div
    class="mx-auto flex max-w-3xl flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-lg dark:border-gray-700 dark:bg-gray-900 sm:flex-row sm:items-center"
  >
    <p class="flex-1 text-sm leading-relaxed text-gray-700 dark:text-gray-300">
      Kami memakai cookie analitik dari Google Analytics untuk memahami konten yang paling berguna. Fitur ini hanya diaktifkan setelah Anda memberikan persetujuan. Detail selengkapnya tersedia di <a
        href="/privacy-policy"
        class="font-medium text-primary underline underline-offset-2 hover:text-primary-hover"
        >Kebijakan Privasi</a
      >.
    </p>
    <div class="flex shrink-0 gap-2">
      <button
        id="consent-decline"
        type="button"
        class="rounded-lg border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-100 dark:border-gray-600 dark:text-gray-300 dark:hover:bg-gray-800"
      >
        Tolak
      </button>
      <button
        id="consent-accept"
        type="button"
        class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white transition hover:bg-primary-hover"
      >
        Setuju
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ ga4Id: GA4_MEASUREMENT_ID }}>
  (() => {
    const KEY = 'teknopulse-consent-ga4';
    const banner = document.getElementById('cookie-consent');
    if (!banner) return;

    // Setara bootstrap standar gtag.js — dijalankan hanya setelah persetujuan.
    const loadGa4 = () => {
      if (document.querySelector('script[data-ga4]')) return;
      window.dataLayer = window.dataLayer || [];
      window.gtag = (...args) => {
        window.dataLayer.push(args);
      };
      window.gtag('js', new Date());
      window.gtag('config', ga4Id);
      const s = document.createElement('script');
      s.async = true;
      s.dataset.ga4 = ga4Id;
      s.src = `https://www.googletagmanager.com/gtag/js?id=${ga4Id}`;
      document.head.appendChild(s);
    };

    const decide = (value) => {
      try {
        localStorage.setItem(KEY, value);
      } catch {
        /* penyimpanan diblokir — banner akan tampil tiap kunjungan */
      }
      banner.hidden = true;
      if (value === 'granted') loadGa4();
    };

    let stored = null;
    try {
      stored = localStorage.getItem(KEY);
    } catch {
      /* sama seperti di atas */
    }
    if (stored === 'granted') {
      loadGa4();
    } else if (stored !== 'denied') {
      banner.hidden = false;
    }

    document.getElementById('consent-accept')?.addEventListener('click', () => decide('granted'));
    document.getElementById('consent-decline')?.addEventListener('click', () => decide('denied'));
  })();
</script>
