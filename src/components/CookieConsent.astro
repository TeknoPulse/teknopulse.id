---
// Banner persetujuan cookie analitik (UU PDP) — ADR 0001: Soft Consent Banner.
//
// GA4 (G-79X7QWV977) menaruh cookie _ga sehingga butuh persetujuan dulu.
// Cloudflare Web Analytics tidak lewat komponen ini — cookieless, tanpa consent.
//
// Analytics consent state (tiga nilai, lihat CONTEXT.md):
//   "granted"  → GA4 dimuat, banner tidak muncul lagi
//   "denied"   → GA4 tidak pernah dimuat, banner tidak muncul lagi
//   "deferred" → belum ada keputusan; banner muncul lagi esok hari (maks 3 hari
//                per siklus, lalu jeda 30 hari, kemudian siklus baru)
//
// localStorage key: teknopulse-consent-ga4
// Schema: { decision, dismissCount, lastDismissed, cycleStarted }
// (string lama "granted"/"denied" dimigrasikan otomatis ke schema baru)
const GA4_MEASUREMENT_ID = 'G-79X7QWV977';
---

<div
  id="cookie-consent"
  hidden
  role="region"
  aria-label="Persetujuan cookie analitik"
  class="fixed inset-x-0 bottom-0 z-50 p-4"
>
  <div
    class="relative mx-auto max-w-3xl rounded-xl border border-gray-200 bg-white p-4 shadow-lg dark:border-gray-700 dark:bg-gray-900"
  >
    <!-- Close button [×] — de-emphasized, top-right -->
    <button
      id="consent-close"
      type="button"
      aria-label="Tutup banner"
      class="absolute top-2 right-2 rounded-md p-1 text-gray-400 transition hover:bg-gray-100 hover:text-gray-600 focus:outline-none focus:ring-2 focus:ring-primary dark:hover:bg-gray-800 dark:hover:text-gray-300"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-4 w-4"
        viewBox="0 0 20 20"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          fill-rule="evenodd"
          d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
          clip-rule="evenodd"></path>
      </svg>
    </button>

    <div class="flex flex-col gap-3 pr-6 sm:flex-row sm:items-center">
      <p class="flex-1 text-sm leading-relaxed text-gray-700 dark:text-gray-300">
        Kami memakai Google Analytics untuk memahami konten yang berguna. Anda dapat mengubah
        preferensi ini kapan saja di <a
          href="/privacy-policy"
          class="font-medium text-primary underline underline-offset-2 hover:text-primary-hover"
          >Kebijakan Privasi</a
        >.
      </p>
      <button
        id="consent-accept"
        type="button"
        class="shrink-0 rounded-lg bg-primary px-5 py-2 text-sm font-semibold text-white transition hover:bg-primary-hover focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2"
      >
        Setuju
      </button>
    </div>
  </div>
</div>

<script is:inline define:vars={{ ga4Id: GA4_MEASUREMENT_ID }}>
  (() => {
    const KEY = 'teknopulse-consent-ga4';
    const CYCLE_MAX = 3; // dismissals per cycle before 30-day rest
    const REST_DAYS = 30; // days to wait after CYCLE_MAX dismissals

    const banner = document.getElementById('cookie-consent');
    if (!banner) return;

    // Setara bootstrap standar gtag.js — dijalankan hanya setelah persetujuan.
    const loadGa4 = () => {
      if (document.querySelector('script[data-ga4]')) return;
      window.dataLayer = window.dataLayer || [];
      window.gtag = (...args) => {
        window.dataLayer.push(args);
      };
      window.gtag('js', new Date());
      window.gtag('config', ga4Id);
      const s = document.createElement('script');
      s.async = true;
      s.dataset.ga4 = ga4Id;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + ga4Id;
      document.head.appendChild(s);
    };

    const getTodayString = () => new Date().toISOString().slice(0, 10); // "YYYY-MM-DD"

    const daysBetween = (dateStr1, dateStr2) => {
      const d1 = new Date(dateStr1);
      const d2 = new Date(dateStr2);
      return Math.floor((d2 - d1) / 86400000);
    };

    // Read and migrate localStorage: old bare-string format → new JSON schema.
    const getStored = () => {
      try {
        const raw = localStorage.getItem(KEY);
        if (!raw) return null;
        // Migrate legacy bare-string values from old two-button implementation.
        if (raw === 'granted' || raw === 'denied') {
          const migrated = {
            decision: raw,
            dismissCount: 0,
            lastDismissed: null,
            cycleStarted: null,
          };
          localStorage.setItem(KEY, JSON.stringify(migrated));
          return migrated;
        }
        return JSON.parse(raw);
      } catch {
        return null;
      }
    };

    const saveStored = (obj) => {
      try {
        localStorage.setItem(KEY, JSON.stringify(obj));
      } catch {
        /* storage blocked — banner will reappear next visit */
      }
    };

    // Determine whether to show banner based on consent state and cycle logic.
    const shouldShow = (stored) => {
      if (!stored || stored.decision === 'deferred') {
        // First ever visit.
        if (!stored || !stored.lastDismissed) return true;

        const today = getTodayString();
        const daysSince = daysBetween(stored.lastDismissed, today);

        if (stored.dismissCount < CYCLE_MAX) {
          // Within active cycle: show again next calendar day.
          return daysSince >= 1;
        }

        // Cycle exhausted: wait REST_DAYS then start fresh.
        return daysSince >= REST_DAYS;
      }
      return false; // granted or denied → never show
    };

    const stored = getStored();

    if (stored?.decision === 'granted') {
      loadGa4();
      return;
    }

    if (shouldShow(stored)) {
      banner.hidden = false;
    }

    // "Setuju" → grant, load GA4, never show again.
    document.getElementById('consent-accept')?.addEventListener('click', () => {
      saveStored({ decision: 'granted', dismissCount: 0, lastDismissed: null, cycleStarted: null });
      banner.hidden = true;
      loadGa4();
    });

    // [×] → deferred, increment cycle counter.
    document.getElementById('consent-close')?.addEventListener('click', () => {
      const current = getStored();
      const today = getTodayString();

      let dismissCount = (current?.dismissCount || 0) + 1;
      let cycleStarted = current?.cycleStarted || today;

      // If we just completed a full cycle rest, reset the counter.
      if (
        current?.dismissCount >= CYCLE_MAX &&
        current?.lastDismissed &&
        daysBetween(current.lastDismissed, today) >= REST_DAYS
      ) {
        dismissCount = 1;
        cycleStarted = today;
      }

      saveStored({
        decision: 'deferred',
        dismissCount,
        lastDismissed: today,
        cycleStarted,
      });
      banner.hidden = true;
    });
  })();
</script>
