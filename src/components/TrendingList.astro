---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<section class="bg-gray-50/50 dark:bg-gray-900/50 py-12 border-y border-gray-200 dark:border-gray-800">
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between mb-8">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">🔥 Trending Minggu Ini</h2>
      <a href="/posts" class="text-sm font-medium text-primary hover:text-primary-dark transition-colors dark:text-orange-400 dark:hover:text-orange-300">
        Lihat Semua &rarr;
      </a>
    </div>

    <div class="flex flex-col">
      {posts.map((post, index) => (
        <a 
          href={`/posts/${post.slug}`}
          class="group block border-b border-gray-200 dark:border-gray-800 last:border-b-0 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-200 rounded-lg -mx-4 px-4 py-4"
        >
          <article class="flex items-center gap-4 sm:gap-6">
            <div class="flex-shrink-0 w-8 sm:w-12 text-center">
              <span class="ranking-number text-4xl lg:text-5xl font-bold">{index + 1}</span>
            </div>
            
            <div class="flex-grow min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class={`category-badge category-${post.data.category.toLowerCase()}`}>
                  {post.data.category}
                </span>
              </div>
              <h3 class="text-base lg:text-lg font-semibold text-gray-900 dark:text-white line-clamp-2 mb-1 group-hover:text-primary dark:group-hover:text-orange-400 transition-colors">
                {post.data.title}
              </h3>
              <div class="flex items-center text-xs text-gray-500 dark:text-gray-400">
                <time datetime={post.data.publishedAt.toISOString()}>
                  {post.data.publishedAt.toLocaleDateString('id-ID', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                {post.data.readingTime && (
                  <>
                    <span class="mx-2">&bull;</span>
                    <span>{post.data.readingTime} min read</span>
                  </>
                )}
              </div>
            </div>
            
            {post.data.coverImage && (
              <div class="hidden sm:block flex-shrink-0">
                <Image 
                  src={post.data.coverImage} 
                  alt={post.data.title}
                  width={64}
                  height={64}
                  class="w-16 h-16 object-cover rounded shadow-sm"
                  loading="lazy"
                />
              </div>
            )}
          </article>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .ranking-number {
    background: linear-gradient(135deg, hsl(24, 90%, 55%), #d94b38); /* Primary to Accent/Terracotta */
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
