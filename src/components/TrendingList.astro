---
import type { CollectionEntry } from 'astro:content';
import { getCategoryLabel, getCategoryToken } from '../utils/categories';
import { Image } from 'astro:assets';

interface Props {
  posts: CollectionEntry<'posts'>[];
}

const { posts } = Astro.props;
---

<section
  class="border-y border-gray-200 bg-gray-50/50 py-12 dark:border-gray-800 dark:bg-gray-900/50"
>
  <div class="container mx-auto px-4">
    <div class="mb-8 flex items-center justify-between">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-white">🔥 Trending Minggu Ini</h2>
      <a
        href="/posts"
        class="hover:text-primary-dark text-sm font-medium text-primary transition-colors dark:text-orange-400 dark:hover:text-orange-300"
      >
        Lihat Semua &rarr;
      </a>
    </div>

    <div class="flex flex-col">
      {
        posts.map((post, index) => (
          <a
            href={`/posts/${post.slug}`}
            class="group -mx-4 block rounded-lg border-b border-gray-200 px-4 py-4 transition-colors duration-200 last:border-b-0 hover:bg-gray-100 dark:border-gray-800 dark:hover:bg-gray-800"
          >
            <article class="flex items-center gap-4 sm:gap-6">
              <div class="w-8 flex-shrink-0 text-center sm:w-12">
                <span class="ranking-number text-4xl font-bold lg:text-5xl">{index + 1}</span>
              </div>

              <div class="min-w-0 flex-grow">
                <div class="mb-1 flex items-center gap-2">
                  <span class={`category-badge category-${getCategoryToken(post.data.category)}`}>
                    {getCategoryLabel(post.data.category)}
                  </span>
                </div>
                <h3 class="line-clamp-2 mb-1 text-base font-semibold text-gray-900 transition-colors group-hover:text-primary dark:text-white dark:group-hover:text-orange-400 lg:text-lg">
                  {post.data.title}
                </h3>
                <div class="flex items-center text-xs text-gray-500 dark:text-gray-400">
                  <time datetime={post.data.publishedAt.toISOString()}>
                    {post.data.publishedAt.toLocaleDateString('id-ID', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  {post.data.readingTime && (
                    <>
                      <span class="mx-2">&bull;</span>
                      <span>{post.data.readingTime} min read</span>
                    </>
                  )}
                </div>
              </div>

              {post.data.coverImage && (
                <div class="hidden flex-shrink-0 sm:block">
                  <Image
                    src={post.data.coverImage}
                    alt={post.data.title}
                    width={64}
                    height={64}
                    class="h-16 w-16 rounded object-cover shadow-sm"
                    loading="lazy"
                  />
                </div>
              )}
            </article>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .ranking-number {
    background: linear-gradient(
      135deg,
      hsl(24, 90%, 55%),
      #d94b38
    ); /* Primary to Accent/Terracotta */
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
