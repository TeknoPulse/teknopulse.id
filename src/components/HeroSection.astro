---
import type { CollectionEntry } from 'astro:content';
import { getCategoryLabel, getCategoryToken } from '../utils/categories';
import { Image } from 'astro:assets';

interface Props {
  leadPost: CollectionEntry<'posts'>;
  secondaryPosts: CollectionEntry<'posts'>[];
}

const { leadPost, secondaryPosts } = Astro.props;

// Date formatter
const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(date);
};
---

<section aria-label="Berita Utama" class="mb-12">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <!-- Lead Story (Left Side - 60%) -->
    <div class="lg:col-span-7 xl:col-span-8">
      <article class="group relative h-full">
        <a
          href={`/posts/${leadPost.slug}`}
          class="card block h-full transition-shadow duration-300 hover:shadow-lg"
        >
          <div class="relative aspect-video w-full overflow-hidden rounded-t-xl">
            {
              leadPost.data.coverImage ? (
                <Image
                  src={leadPost.data.coverImage}
                  alt={leadPost.data.title}
                  width={800}
                  height={450}
                  loading="eager"
                  fetchpriority="high"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gray-200 dark:bg-gray-800">
                  <span class="text-gray-400 dark:text-gray-600">Gambar tidak tersedia</span>
                </div>
              )
            }

            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/60 to-transparent"
            >
            </div>

            <div class="absolute top-4 left-4">
              <span class={`category-badge category-${getCategoryToken(leadPost.data.category)}`}>
                {getCategoryLabel(leadPost.data.category)}
              </span>
            </div>
          </div>

          <div class="p-6">
            <h1
              class="line-clamp-2 mb-3 text-3xl font-bold text-gray-900 transition-colors group-hover:text-primary dark:text-white lg:text-4xl"
            >
              {leadPost.data.title}
            </h1>

            <p class="line-clamp-3 mb-4 text-lg text-gray-600 dark:text-gray-300">
              {leadPost.data.summary}
            </p>

            <div class="flex items-center space-x-4 text-sm text-gray-500 dark:text-gray-400">
              <span>{leadPost.data.author}</span>
              <span>&bull;</span>
              <time datetime={leadPost.data.publishedAt.toISOString()}>
                {formatDate(leadPost.data.publishedAt)}
              </time>
              {
                leadPost.data.readingTime && (
                  <>
                    <span>&bull;</span>
                    <span>{leadPost.data.readingTime} mnt baca</span>
                  </>
                )
              }
            </div>
          </div>
        </a>
      </article>
    </div>

    <!-- Secondary Stories (Right Side - 40%) -->
    <div class="flex flex-col justify-between lg:col-span-5 xl:col-span-4">
      <div class="flex h-full flex-col space-y-0">
        {
          secondaryPosts.slice(0, 4).map((post, index) => (
            <article
              class={`flex flex-1 flex-col justify-center py-4 ${index !== Math.min(3, secondaryPosts.length - 1) ? 'border-b border-gray-200 dark:border-gray-800' : ''}`}
            >
              <a href={`/posts/${post.slug}`} class="group flex items-start space-x-4">
                <div class="aspect-square h-20 w-20 flex-shrink-0 overflow-hidden rounded-lg">
                  {post.data.coverImage ? (
                    <Image
                      src={post.data.coverImage}
                      alt={post.data.title}
                      width={80}
                      height={80}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-gray-200 dark:bg-gray-800">
                      <span class="text-xs text-gray-400 dark:text-gray-600">No img</span>
                    </div>
                  )}
                </div>

                <div class="min-w-0 flex-1">
                  <div class="mb-1">
                    <span
                      class={`category-badge category-${getCategoryToken(post.data.category)} !px-2 !py-0.5 !text-[10px]`}
                    >
                      {getCategoryLabel(post.data.category)}
                    </span>
                  </div>
                  <h2 class="line-clamp-2 mb-1 text-base font-semibold text-gray-900 transition-colors group-hover:text-primary dark:text-white">
                    {post.data.title}
                  </h2>
                  <time
                    datetime={post.data.publishedAt.toISOString()}
                    class="text-xs text-gray-500 dark:text-gray-400"
                  >
                    {formatDate(post.data.publishedAt)}
                  </time>
                </div>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
