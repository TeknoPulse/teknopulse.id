---
interface Props {
  variant?: 'demo' | 'real';
}

const { variant = 'demo' } = Astro.props;
const pathname = Astro.url.pathname;

const demoLinks = [
  { href: '/edisi/', label: 'Edisi' },
  { href: '/topik/', label: 'Topik' },
  { href: '/cari/', label: 'Cari' },
  { href: '/baca-nanti/', label: 'Baca nanti' },
];

const realLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/posts/', label: 'Artikel' },
  { href: '/category/', label: 'Rubrik' },
  { href: '/search/', label: 'Cari' },
  { href: '/about/', label: 'Tentang' },
];

const isDemo = variant === 'demo';
const links = isDemo ? demoLinks : realLinks;

const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---

<header class="sticky top-0 z-50 border-b border-rule bg-paper/95 backdrop-blur">
  <div class="wrap flex h-14 items-center justify-between gap-4">
    <a
      href="/"
      class="font-display text-[1.35rem] font-semibold leading-none tracking-headline text-ink"
      aria-label="TeknoPulse — beranda"
    >
      TeknoPulse<span class="text-cobalt">.</span>
    </a>

    <nav class="hidden items-center gap-7 md:flex" aria-label="Navigasi utama">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'kicker transition-colors hover:text-cobalt',
              isActive(link.href) ? 'text-cobalt' : 'text-ink-soft',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
            {link.href === '/baca-nanti/' && (
              <span
                data-readlater-count
                hidden
                class="min-w-5 ml-1.5 inline-flex items-center justify-center bg-cobalt px-1.5 py-0.5 align-middle text-[0.625rem] leading-none text-paper-light"
              >
                0
              </span>
            )}
          </a>
        ))
      }
      {
        isDemo && (
          <>
            <span class="h-4 w-px bg-rule" aria-hidden="true" />
            <a
              href="/posts/"
              class="kicker text-ink-muted transition-colors hover:text-cobalt"
              title="Arsip artikel lama di luar edisi demo"
            >
              Arsip lama
            </a>
          </>
        )
      }
    </nav>

    {
      isDemo && (
        <a
          href="/baca-nanti/"
          class="kicker inline-flex items-center gap-1.5 text-ink-soft hover:text-cobalt md:hidden"
          aria-label="Baca nanti"
        >
          <svg
            class="h-4 w-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path d="M6 4.5h12v15l-6-3.8-6 3.8z" stroke-linejoin="round" />
          </svg>
          <span
            data-readlater-count
            hidden
            class="min-w-5 inline-flex items-center justify-center bg-cobalt px-1.5 py-0.5 text-[0.625rem] leading-none text-paper-light"
          >
            0
          </span>
        </a>
      )
    }
  </div>

  <nav class="border-t border-rule/70 md:hidden" aria-label="Navigasi utama seluler">
    <div class="wrap flex flex-wrap items-center gap-x-1 gap-y-0.5 py-1.5">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'kicker shrink-0 px-2 py-2 transition-colors hover:text-cobalt',
              isActive(link.href) ? 'text-cobalt' : 'text-ink-soft',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      {
        isDemo && (
          <a href="/posts/" class="kicker shrink-0 px-2 py-2 text-ink-muted hover:text-cobalt">
            Arsip lama
          </a>
        )
      }
    </div>
  </nav>
</header>

<script>
  import { initReadLater } from '../scripts/read-later';

  initReadLater();
</script>
