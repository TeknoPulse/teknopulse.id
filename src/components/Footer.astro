---
import { site } from '../config';
import { formatShortDate, getIssues, issueUrl, topics, topicUrl } from '../utils/edisi';
import { getAllCategories } from '../utils/categories';
import { getCategoryUrl } from '../utils/urls.mjs';

interface Props {
  variant?: 'demo' | 'real';
}

const { variant = 'demo' } = Astro.props;
const isDemo = variant === 'demo';
const issues = isDemo ? await getIssues() : [];
const categories = getAllCategories().sort((a, b) => a.name.localeCompare(b.name));
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t-2 border-rule-strong bg-paper">
  <div class="wrap py-10 sm:py-14">
    <div class="grid gap-10 border-b border-rule pb-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <a href="/" class="font-display text-4xl font-semibold tracking-headline text-ink">
          TeknoPulse<span class="text-cobalt">.</span>
        </a>
        <p class="mt-3 max-w-sm font-serif text-lg leading-snug text-ink-soft">
          {
            isDemo
              ? 'Surat kabar teknologi mingguan: laporan, esai, dan ringkas tentang mesin, manusia, dan keputusan di antaranya.'
              : site.description
          }
        </p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-7">
        {
          isDemo ? (
            <nav aria-labelledby="footer-issues">
              <h2 id="footer-issues" class="kicker text-ink-muted">
                Edisi
              </h2>
              <ul class="mt-3 space-y-2 text-sm">
                {issues.map((issue) => (
                  <li>
                    <a href={issueUrl(issue.data.number)} class="hover:text-cobalt">
                      <span class="font-medium">
                        No. {String(issue.data.number).padStart(2, '0')}
                      </span>
                      <span class="text-ink-muted"> — {formatShortDate(issue.data.date)}</span>
                    </a>
                  </li>
                ))}
                <li>
                  <a href="/edisi/" class="text-ink-muted hover:text-cobalt">
                    Semua edisi →
                  </a>
                </li>
              </ul>
            </nav>
          ) : (
            <nav aria-labelledby="footer-jelajah">
              <h2 id="footer-jelajah" class="kicker text-ink-muted">
                Jelajah
              </h2>
              <ul class="mt-3 space-y-2 text-sm">
                <li>
                  <a href="/" class="hover:text-cobalt">
                    Beranda
                  </a>
                </li>
                <li>
                  <a href="/posts/" class="hover:text-cobalt">
                    Semua artikel
                  </a>
                </li>
                <li>
                  <a href="/category/" class="hover:text-cobalt">
                    Rubrik
                  </a>
                </li>
                <li>
                  <a href="/search/" class="hover:text-cobalt">
                    Cari artikel
                  </a>
                </li>
              </ul>
            </nav>
          )
        }

        {
          isDemo ? (
            <nav aria-labelledby="footer-topics">
              <h2 id="footer-topics" class="kicker text-ink-muted">
                Rubrik
              </h2>
              <ul class="mt-3 space-y-2 text-sm">
                {topics.map((topic) => (
                  <li>
                    <a href={topicUrl(topic.slug)} class="hover:text-cobalt">
                      {topic.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ) : (
            <nav aria-labelledby="footer-rubrik">
              <h2 id="footer-rubrik" class="kicker text-ink-muted">
                Rubrik
              </h2>
              <ul class="mt-3 space-y-2 text-sm">
                {categories.map((category) => (
                  <li>
                    <a href={getCategoryUrl(category.slug)} class="hover:text-cobalt">
                      {category.name}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }

        <nav aria-labelledby="footer-site">
          <h2 id="footer-site" class="kicker text-ink-muted">Situs</h2>
          <ul class="mt-3 space-y-2 text-sm">
            {
              isDemo && (
                <li>
                  <a href="/cari/" class="hover:text-cobalt">
                    Cari artikel
                  </a>
                </li>
              )
            }
            {
              !isDemo && (
                <li>
                  <a href="/about/" class="hover:text-cobalt">
                    Tentang
                  </a>
                </li>
              )
            }
            <li>
              <a href="/contact/" class="hover:text-cobalt"> Kontak </a>
            </li>
            <li>
              <a href="/rss.xml" class="hover:text-cobalt"> RSS </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="grid gap-6 pt-6 text-xs text-ink-muted lg:grid-cols-12">
      <p class="max-w-2xl leading-relaxed lg:col-span-8">
        {
          isDemo ? (
            <>
              <strong class="font-semibold text-ink-soft">Situs demo desain.</strong> Seluruh edisi,
              artikel, nama penulis, organisasi, dan peristiwa di halaman edisi adalah fiktif dan
              dibuat untuk memperlihatkan tata letak. Jangan membacanya sebagai berita atau kabar
              terbaru.
            </>
          ) : (
            'Dibuat dan dirawat di Indonesia. Koreksi dan masukan membantu kami memperbaiki kualitas artikel.'
          )
        }
      </p>
      <div class="flex flex-wrap items-start gap-x-5 gap-y-2 lg:col-span-4 lg:justify-end">
        <span>© {year} {site.name}</span>
        <a href="/privacy-policy/" class="hover:text-cobalt">Privasi</a>
        <a href="/terms-of-service/" class="hover:text-cobalt">Ketentuan</a>
      </div>
    </div>
  </div>
</footer>
