---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ShareButtons from './ShareButtons.astro';
import { calculateReadingTime } from '../utils/readingTime';
import { getAuthor, getAuthorUrl } from '../utils/authors';
import { coverAlt } from '../utils/coverAlt';
import { getAllCategories, getCategoryLabel, getCategoryUrl } from '../utils/categories';
import { getGuideUrl, getTagUrl, slugifyTag } from '../utils/urls.mjs';
import { formatDate } from '../utils/dates';
import {
  generateGuideSchema,
  generateHowToSchema,
  schemasToJsonLd,
} from '../../scripts/utils/schema-generator';

interface Props {
  guide: CollectionEntry<'guides'>;
  ogImage?: CollectionEntry<'guides'>['data']['coverImage'] | string;
}

const { guide, ogImage } = Astro.props;

const { Content } = await guide.render();

const readingTime = guide.data.readingTime ?? calculateReadingTime(guide.body);
const author = getAuthor(guide.data.author);
const authorName = author?.name ?? guide.data.author;

const description = guide.data.metaDescription ?? guide.data.description;
const updated =
  guide.data.updatedAt &&
  guide.data.updatedAt.toISOString().slice(0, 10) !==
    guide.data.publishedAt.toISOString().slice(0, 10)
    ? guide.data.updatedAt
    : undefined;

const faq = guide.data.faq ?? [];
const tags = guide.data.tags ?? [];
const category = getCategoryLabel(guide.data.category);
const categoryUrl = getCategoryUrl(guide.data.category);
const categories = getAllCategories().sort((a, b) => a.name.localeCompare(b.name));
const sources = guide.data.sources ?? [];

// Generate schema.org JSON-LD
const fmForSchema = {
  title: guide.data.title,
  slug: guide.slug,
  description: guide.data.description,
  publishedAt: guide.data.publishedAt,
  updatedAt: guide.data.updatedAt,
  tags: guide.data.tags,
  category: guide.data.category,
  author: authorName,
  targetKeyword: guide.data.targetKeyword,
  secondaryKeywords: guide.data.secondaryKeywords,
  sources: guide.data.sources,
  faq: guide.data.faq,
  coverImage: guide.data.coverImage?.src,
  readingTime: readingTime,
};

let schemaJsonLd = '';
// Detect if content is HowTo (has numbered steps) or Guide
const isHowTo = /^##\s+(?:Langkah|Step)\s+\d+/m.test(guide.body);
if (isHowTo) {
  // Extract steps for HowTo schema
  const steps = guide.body
    .split('\n## ')
    .slice(1)
    .filter((s) => /^(?:Langkah|Step)\s+\d+/.test(s.trim()))
    .map((step) => {
      const lines = step.split('\n');
      const name = lines[0].replace(/^(?:Langkah|Step)\s+\d+[:.]\s*/, '').trim();
      const text = lines.slice(1).join('\n').trim().substring(0, 1000);
      return { name, text };
    });
  if (steps.length >= 3) {
    schemaJsonLd = schemasToJsonLd([generateHowToSchema(fmForSchema, steps, [], [], readingTime)]);
  }
}
if (!schemaJsonLd) {
  schemaJsonLd = schemasToJsonLd([generateGuideSchema(fmForSchema)]);
}
// FAQPage TIDAK dibuat di sini: <Layout article={{ faq }}> sudah memicunya lewat
// Seo.astro. Menambahkannya lagi menghasilkan dua FAQPage di halaman yang sama.
---

<Layout
  title={guide.data.title}
  description={description}
  image={ogImage}
  imageAlt={guide.data.title}
  article={{
    publishedTime: guide.data.publishedAt.toISOString(),
    modifiedTime: guide.data.updatedAt?.toISOString(),
    author: {
      name: authorName,
      url: author ? getAuthorUrl(author) : undefined,
    },
    tags: guide.data.tags,
    category: guide.data.category,
    faq,
    sources: sources.map((s) => ({ name: s.title, url: s.url, primary: true })),
  }}
  showBreadcrumbs={false}
>
  <Fragment set:html={schemaJsonLd} />

  <main>
    <Breadcrumbs postCategory={guide.data.category} postTitle={guide.data.title} showNav={false} />

    <article>
      <header class="border-b-2 border-rule-strong">
        <div class="wrap pt-8 pb-7 sm:pt-12">
          <nav
            aria-label="Remah roti"
            class="kicker flex flex-wrap items-center gap-2 text-ink-muted"
          >
            <a href="/" class="hover:text-cobalt">Beranda</a>
            <span aria-hidden="true" class="text-rule">/</span>
            <a href="/guides/" class="hover:text-cobalt">Panduan</a>
            <span aria-hidden="true" class="hidden text-rule sm:inline">/</span>
            <a href={categoryUrl} class="hover:text-cobalt">{category}</a>
            <span aria-hidden="true" class="hidden text-rule sm:inline">/</span>
            <span class="hidden text-ink-soft sm:inline">{guide.data.title}</span>
          </nav>

          <p class="kicker mt-7 text-cobalt">
            {category}
            <span class="mx-2 text-rule">/</span>
            <time datetime={guide.data.publishedAt.toISOString()}>
              {formatDate(guide.data.publishedAt)}
            </time>
            <span class="mx-2 text-rule">/</span>
            <span
              class="inline-flex items-center gap-1.5 rounded-full bg-amber-100 px-2 py-0.5 text-xs font-medium text-amber-800"
            >
              {
                guide.data.difficulty === 'pemula'
                  ? '🟢 Pemula'
                  : guide.data.difficulty === 'menengah'
                    ? '🟡 Menengah'
                    : '🔴 Lanjutan'
              }
            </span>
          </p>

          <h1
            class="headline-balance mt-3 max-w-5xl font-serif text-[clamp(2.4rem,5.6vw,4.6rem)] font-semibold leading-[0.94] tracking-headline"
          >
            {guide.data.title}
          </h1>

          <p
            class="mt-5 max-w-3xl font-serif text-xl italic leading-snug text-ink-soft sm:text-2xl"
          >
            {description}
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 border-y border-rule py-3.5">
            <span class="kicker text-ink">
              Oleh
              {
                author ? (
                  <a href={getAuthorUrl(author)} class="font-semibold hover:text-cobalt">
                    {author.name}
                  </a>
                ) : (
                  <span class="font-semibold">{guide.data.author}</span>
                )
              }
            </span>
            <time datetime={guide.data.publishedAt.toISOString()} class="kicker text-ink-muted">
              {formatDate(guide.data.publishedAt)}
            </time>
            {
              updated && (
                <span class="kicker text-ink-muted">
                  Diperbarui <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
                </span>
              )
            }
            <span class="kicker text-ink-muted">{readingTime} menit baca</span>
          </div>
        </div>
      </header>

      {
        guide.data.coverImage && (
          <figure class="wrap pt-8 sm:pt-10">
            <Image
              src={guide.data.coverImage}
              alt={coverAlt(guide)}
              width={1280}
              height={720}
              loading="eager"
              fetchpriority="high"
              class="aspect-[16/9] w-full object-cover"
            />
          </figure>
        )
      }

      <div class="wrap py-10 sm:py-14">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-0">
          <div class="lg:col-span-8 lg:pr-12">
            <div class="prose-news max-w-reading" data-pagefind-body>
              <Content />
            </div>

            <ShareButtons title={guide.data.title} url={getGuideUrl(guide.slug)} />

            {
              faq.length > 0 && (
                <section class="mt-10 border-t border-rule pt-6" aria-labelledby="faq-heading">
                  <h2 id="faq-heading" class="font-serif text-2xl font-semibold">
                    Pertanyaan yang Sering Diajukan
                  </h2>
                  <div class="mt-2 divide-y divide-rule">
                    {faq.map((item) => (
                      <div class="py-5">
                        <h3 class="font-serif text-lg font-semibold leading-snug">
                          {item.question}
                        </h3>
                        <p class="mt-2 text-sm leading-relaxed text-ink-muted">{item.answer}</p>
                      </div>
                    ))}
                  </div>
                </section>
              )
            }

            {
              guide.data.sources && guide.data.sources.length > 0 && (
                <section class="mt-10 border-t border-rule pt-6" aria-labelledby="sumber-heading">
                  <h2 id="sumber-heading" class="font-serif text-2xl font-semibold">
                    Sumber & Referensi
                  </h2>
                  <ul class="mt-4 divide-y divide-rule">
                    {guide.data.sources.map((source) => (
                      <li class="flex flex-wrap items-baseline gap-x-2 gap-y-1 py-3 text-sm leading-relaxed">
                        <span class="text-ink">{source.title}</span>
                        <a
                          href={source.url}
                          target="_blank"
                          rel="noopener"
                          class="break-all text-cobalt underline decoration-rule underline-offset-4 hover:text-cobalt-dark"
                        >
                          {source.url}
                        </a>
                        {source.author && <span class="text-ink-muted">— {source.author}</span>}
                        {source.date && (
                          <time class="text-ink-muted" datetime={source.date}>
                            {source.date}
                          </time>
                        )}
                      </li>
                    ))}
                  </ul>
                </section>
              )
            }
          </div>

          <aside class="lg:col-span-4 lg:border-l lg:border-rule lg:pl-10">
            <div class="lg:sticky lg:top-24">
              <section aria-labelledby="sekilas-panduan">
                <div class="flex items-baseline justify-between border-b-2 border-rule-strong pb-2">
                  <h2 id="sekilas-panduan" class="font-serif text-2xl font-semibold">Sekilas</h2>
                  <span class="kicker text-ink-muted">Panduan</span>
                </div>
                <dl class="divide-y divide-rule text-sm">
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Kategori</dt>
                    <dd>
                      <a href={categoryUrl} class="text-cobalt hover:text-cobalt-dark">
                        {category}
                      </a>
                    </dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Penulis</dt>
                    <dd class="text-right text-ink">
                      {
                        author ? (
                          <a href={getAuthorUrl(author)} class="hover:text-cobalt">
                            {author.name}
                          </a>
                        ) : (
                          guide.data.author
                        )
                      }
                    </dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Terbit</dt>
                    <dd class="text-right text-ink">
                      <time datetime={guide.data.publishedAt.toISOString()}>
                        {formatDate(guide.data.publishedAt)}
                      </time>
                    </dd>
                  </div>
                  {
                    updated && (
                      <div class="flex items-baseline justify-between gap-4 py-3">
                        <dt class="kicker text-ink-muted">Diperbarui</dt>
                        <dd class="text-right text-ink">
                          <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
                        </dd>
                      </div>
                    )
                  }
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Waktu baca</dt>
                    <dd class="text-right text-ink">{readingTime} menit</dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Level</dt>
                    <dd class="text-right text-ink">
                      {
                        guide.data.difficulty === 'pemula'
                          ? '🟢 Pemula'
                          : guide.data.difficulty === 'menengah'
                            ? '🟡 Menengah'
                            : '🔴 Lanjutan'
                      }
                    </dd>
                  </div>
                  <div class="flex items-baseline justify-between gap-4 py-3">
                    <dt class="kicker text-ink-muted">Target keyword</dt>
                    <dd class="max-w-[180px] truncate text-right text-xs text-ink">
                      {guide.data.targetKeyword}
                    </dd>
                  </div>
                </dl>
              </section>

              {
                tags.length > 0 && (
                  <section class="mt-8 border-t border-rule pt-5" aria-labelledby="tag-panduan">
                    <h2 id="tag-panduan" class="kicker text-ink-muted">
                      Tag
                    </h2>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {tags.map((tag) => (
                        <a
                          href={getTagUrl(slugifyTag(tag))}
                          class="kicker border border-rule px-2 py-1 text-ink-soft hover:border-cobalt hover:text-cobalt"
                        >
                          {tag}
                        </a>
                      ))}
                    </div>
                  </section>
                )
              }

              <section class="mt-8 border-t border-rule pt-5" aria-labelledby="lain-kategori">
                <h2 id="lain-kategori" class="kicker text-ink-muted">Lain dari {category}</h2>
                <ul class="mt-2 divide-y divide-rule">
                  {
                    categories
                      .filter((c) => c.name !== guide.data.category)
                      .slice(0, 3)
                      .map((cat) => (
                        <li class="py-3">
                          <a
                            href={getCategoryUrl(cat.name)}
                            class="font-serif text-[1.05rem] leading-snug hover:text-cobalt"
                          >
                            {cat.name}
                          </a>
                        </li>
                      ))
                  }
                </ul>
              </section>

              <p class="mt-8 border-l-2 border-cobalt pl-4 text-sm leading-relaxed text-ink-muted">
                Panduan ini bagian dari seri <strong>TeknoPulse</strong> — tips teknologi untuk orang
                awam.
                <a href="/guides/" class="ml-2 text-cobalt hover:text-cobalt-dark"
                  >Lihat semua panduan →</a
                >
              </p>
            </div>
          </aside>
        </div>
      </div>
    </article>
  </main>
</Layout>
