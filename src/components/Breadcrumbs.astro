---
import { site } from '../config';
import { getCategorySlug } from '../utils/categories';
import { getAuthorBySlug } from '../utils/authors';

interface Props {
  postCategory?: string;
  postTitle?: string;
}

const { postCategory, postTitle } = Astro.props;

const pathname = Astro.url.pathname;
const segments = pathname.split('/').filter((s) => s !== '');

let breadcrumbs = [{ name: 'Beranda', url: '/' }];

if (pathname.startsWith('/posts/') && postCategory && postTitle) {
  // Handle post pages: Beranda / Kategori / Judul Artikel
  breadcrumbs.push({
    name: postCategory,
    url: `/category/${getCategorySlug(postCategory)}`,
  });
  breadcrumbs.push({
    name: postTitle,
    url: pathname,
  });
} else if (pathname.startsWith('/authors/')) {
  // Halaman penulis: Beranda / Penulis / Nama Penulis
  breadcrumbs.push({ name: 'Penulis', url: '/authors/' });
  if (segments.length > 1) {
    const author = getAuthorBySlug(segments[1]);
    breadcrumbs.push({
      name: author?.name ?? segments[1].replace(/-/g, ' '),
      url: pathname,
    });
  }
} else {
  // Handle other pages: Beranda / Segment1 / Segment2
  segments.forEach((segment, index) => {
    const url = '/' + segments.slice(0, index + 1).join('/');
    const name = segment
      .replace(/-/g, ' ')
      .split(' ')
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
    breadcrumbs.push({ name, url });
  });
}

// JSON-LD BreadcrumbList (TEKAA-5): satu format structured data, tanpa
// microdata ganda di markup tampilan.
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: new URL(item.url, site.url).href,
  })),
};
---

<nav
  class="container mx-auto px-4 py-2 text-sm text-gray-600 dark:text-gray-400"
  aria-label="breadcrumb"
>
  <ol class="flex space-x-2">
    {
      breadcrumbs.map((item, index) => (
        <li>
          <a
            href={item.url}
            class="hover:underline"
            aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}
          >
            {item.name}
          </a>
          {index < breadcrumbs.length - 1 && <span class="mx-2">/</span>}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
