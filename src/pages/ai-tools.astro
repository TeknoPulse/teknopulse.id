const totalTools = sections.reduce((sum, s) => sum + s.tools.length, 0);

const badgeClass: Record<Tool['pricing'], string> = {
  Gratis:
    'shrink-0 rounded-full bg-emerald-100 px-2.5 py-0.5 text-xs font-medium text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300',
  Freemium:
    'shrink-0 rounded-full bg-amber-100 px-2.5 py-0.5 text-xs font-medium text-amber-800 dark:bg-amber-900/40 dark:text-amber-300',
  Berbayar:
    'shrink-0 rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-medium text-rose-800 dark:bg-rose-900/40 dark:text-rose-300',
};

const faqs = [
  {
    q: 'AI tools mana yang paling cocok untuk pemula?',
    a: 'Mulailah dari ChatGPT atau Gemini. Keduanya punya paket gratis, serbaguna, dan memahami bahasa Indonesia dengan baik. Setelah terbiasa, tambahkan tool spesifik sesuai kebutuhan — misalnya Canva untuk desain atau CapCut untuk video.',
  },
  {
    q: 'Apakah semua tool di daftar ini mendukung bahasa Indonesia?',
    a: 'Mayoritas asisten dan tool menulis memahami bahasa Indonesia dengan baik. Beberapa memang dikhususkan untuk bahasa Inggris seperti Grammarly, dan hal itu sudah kami tandai dengan jelas di setiap entri.',
  },
  {
    q: 'Berapa biaya rata-rata untuk memakai AI tools?',
    a: 'Hampir semua tool di daftar ini punya paket gratis atau kuota gratis harian. Paket berbayar umumnya berkisar US$5 sampai US$20 per bulan. Harga bisa berubah sewaktu-waktu, jadi selalu cek situs resminya sebelum berlangganan.',
  },
  {
    q: 'Bagaimana cara TeknoPulse mengkurasi daftar ini?',
    a: 'Setiap tool dinilai dari kualitas output, dukungan bahasa Indonesia, nilai versus harga, dan kemudahan untuk mulai dipakai. Daftar ini dikurasi manual dan diperbarui secara berkala — tool yang tidak lagi relevan akan kami keluarkan.',
  },
  {
    q: 'Apakah aman memakai AI tools untuk data pekerjaan?',
    a: 'Hindari memasukkan data sensitif atau rahasia perusahaan ke tool gratis tanpa membaca kebijakan privasinya. Gunakan paket bisnis yang menawarkan kontrol data lebih ketat bila datamu memang sensitif.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<Layout
  title={`${totalTools} AI Tools Terbaik untuk Pengguna Indonesia (2026)`}
  description={`Kurasi ${totalTools} AI tools terbaik untuk pengguna Indonesia: chatbot, desain, video, produktivitas, dan coding. Ada opsi gratis, catatan dukungan bahasa Indonesia, dan tips memilih.`}
>
  <main class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-5xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wide text-primary dark:text-accent">
        Direktori AI Tools
      </p>
      <h1 class="mb-4 text-4xl font-bold md:text-5xl">
        {totalTools} AI Tools Terbaik untuk Pengguna Indonesia
      </h1>
      <div
        class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-gray-500 dark:text-gray-400"
      >
        <span>Terakhir diperbarui: {lastUpdated}</span>
        <span aria-hidden="true">•</span>
        <span>Dikurasi manual oleh tim TeknoPulse</span>
      </div>
      <p class="mb-8 max-w-3xl text-lg leading-relaxed text-gray-700 dark:text-gray-300">
        Bukan sekadar daftar panjang. Setiap tool di halaman ini dipilih dan dinilai dari sisi yang
        paling relevan buat pengguna Indonesia: kualitas hasil, dukungan bahasa Indonesia, harga
        termasuk opsi gratisnya, dan mudah tidaknya mulai dipakai. Pilih kategorinya, lalu temukan
        yang paling cocok dengan kebutuhanmu. Belum tahu mulai dari mana? Rangkuman
        <a
          href="/posts/ai-terbaik-2026/"
          class="font-medium text-primary hover:underline dark:text-accent">10 AI Terbaik 2026</a
        >
        jadi titik awal yang baik.
      </p>

      <section id="perbandingan-2026" class="scroll-mt-24 py-8">
        <h2 class="mb-2 text-2xl font-bold md:text-3xl">
          Perbandingan Cepat: AI Terpopuler 2026 &amp; Harganya
        </h2>
        <p class="mb-6 text-gray-600 dark:text-gray-400">
          Ringkasan satu tabel dari pilihan utama di halaman ini — kategori, biaya, dan kegunaan
          terbaiknya. Angka harga adalah langganan resmi: harga rupiah untuk layanan dengan harga
          pasar Indonesia, dan harga US$ asli dari penyedia untuk layanan yang tidak memublikasikan
          harga rupiah; detail dan batas versi gratisnya ada di artikel terkait.
        </p>
        <div class="overflow-x-auto">
          <table class="w-full min-w-[640px] border-collapse text-left text-sm">
            <thead>
              <tr
                class="border-b border-gray-200 text-xs uppercase tracking-wide text-gray-500 dark:border-gray-800 dark:text-gray-400"
              >
                <th scope="col" class="py-2 pr-4 font-semibold">Tool</th>
                <th scope="col" class="py-2 pr-4 font-semibold">Kategori</th>
                <th scope="col" class="py-2 pr-4 font-semibold">Biaya</th>
                <th scope="col" class="py-2 font-semibold">Paling cocok untuk</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
              <tr>
                <th scope="row" class="py-3 pr-4 font-semibold">ChatGPT</th>
                <td class="py-3 pr-4">Asisten &amp; chatbot</td>
                <td class="py-3 pr-4">Gratis; Go Rp75.000, Plus Rp349.000/bulan</td>
                <td class="py-3">Asisten serbaguna untuk kerja &amp; belajar sehari-hari</td>
              </tr>
              <tr>
                <th scope="row" class="py-3 pr-4 font-semibold">Gemini</th>
                <td class="py-3 pr-4">Asisten &amp; chatbot</td>
                <td class="py-3 pr-4">Gratis; Google AI Plus Rp75.000, Pro Rp309.000/bulan</td>
                <td class="py-3">Riset &amp; belajar, terintegrasi ekosistem Google</td>
              </tr>
              <tr>
                <th scope="row" class="py-3 pr-4 font-semibold">Claude</th>
                <td class="py-3 pr-4">Asisten &amp; chatbot</td>
                <td class="py-3 pr-4">Gratis; Pro mulai sekitar US$20/bulan</td>
                <td class="py-3">Tulis-menulis panjang &amp; analisis dokumen</td>
              </tr>
              <tr>
                <th scope="row" class="py-3 pr-4 font-semibold">DeepSeek</th>
                <td class="py-3 pr-4">Asisten &amp; chatbot</td>
                <td class="py-3 pr-4">Gratis tanpa kuota chat</td>
                <td class="py-3">Chat gratis irit dengan Bahasa Indonesia yang fasih</td>
              </tr>
              <tr>
                <th scope="row" class="py-3 pr-4 font-semibold">GitHub Copilot</th>
                <td class="py-3 pr-4">Coding &amp; development</td>
                <td class="py-3 pr-4">Gratis 2.000 completions/bulan; Pro mulai US$10/bulan</td>
                <td class="py-3">Asisten coding di editor (gratis untuk mahasiswa)</td>
              </tr>
              <tr>
                <th scope="row" class="py-3 pr-4 font-semibold">Canva (Magic Studio)</th>
                <td class="py-3 pr-4">Gambar &amp; desain</td>
                <td class="py-3 pr-4">Gratis; Pro mulai Rp95.000/bulan</td>
                <td class="py-3">Desain cepat: sosmed, presentasi, materi kelas</td>
              </tr>
              <tr>
                <th scope="row" class="py-3 pr-4 font-semibold">Suno</th>
                <td class="py-3 pr-4">Video, suara &amp; musik</td>
                <td class="py-3 pr-4">50 kredit/hari (±10 lagu); paket Pro berbayar</td>
                <td class="py-3">Musik &amp; lagu instant tanpa alat musik</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="mt-3 text-xs text-gray-500 dark:text-gray-400">
          Harga dicek 14–20 September 2026 dari halaman resmi masing-masing layanan dan bisa
          berubah. Bandingkan chatbotnya lebih dalam di
          <a
            href="/posts/chatgpt-vs-gemini-vs-claude-2026/"
            class="font-medium text-primary hover:underline dark:text-accent"
            >ChatGPT vs Gemini vs Claude (uji 2026)</a
          >, atau lihat harga lengkap versi gratis &amp; berbayar di
          <a
            href="/posts/ai-terbaik-2026/"
            class="font-medium text-primary hover:underline dark:text-accent">10 AI Terbaik 2026</a
          >.
        </p>
      </section>

      <nav aria-label="Kategori AI tools" class="mb-10 flex flex-wrap gap-2">
        <a
          href="#perbandingan-2026"
          class="rounded-full border border-gray-200 bg-surface px-4 py-1.5 text-sm font-medium text-gray-700 transition-colors hover:border-primary hover:text-primary dark:border-gray-800 dark:bg-surface-dark dark:text-gray-300 dark:hover:border-accent dark:hover:text-accent"
        >
          Perbandingan Cepat
        </a>
        {
          sections.map((section) => (
            <a
              href={`#${section.id}`}
              class="rounded-full border border-gray-200 bg-surface px-4 py-1.5 text-sm font-medium text-gray-700 transition-colors hover:border-primary hover:text-primary dark:border-gray-800 dark:bg-surface-dark dark:text-gray-300 dark:hover:border-accent dark:hover:text-accent"
            >
              {section.title}
              <span class="text-gray-400 dark:text-gray-500"> ({section.tools.length})</span>
            </a>
          ))
        }
        <a
          href="#panduan-review"
          class="rounded-full border border-gray-200 bg-surface px-4 py-1.5 text-sm font-medium text-gray-700 transition-colors hover:border-primary hover:text-primary dark:border-gray-800 dark:bg-surface-dark dark:text-gray-300 dark:hover:border-accent dark:hover:text-accent"
        >
          Panduan &amp; Review
          <span class="text-gray-400 dark:text-gray-500"> ({hubArticles.length})</span>
        </a>
      </nav>

      {
        sections.map((section) => (
          <section id={section.id} class="scroll-mt-24 py-8">
            <h2 class="mb-2 text-2xl font-bold md:text-3xl">{section.title}</h2>
            <p class="mb-6 text-gray-600 dark:text-gray-400">{section.blurb}</p>
            <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              {section.tools.map((tool) => (
                <article class="flex flex-col rounded-lg border border-gray-200 bg-surface p-5 shadow-sm transition-shadow hover:shadow-md dark:border-gray-800 dark:bg-surface-dark">
                  <div class="mb-2 flex items-start justify-between gap-2">
                    <h3 class="text-lg font-semibold">
                      <a
                        href={tool.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="transition-colors hover:text-primary dark:hover:text-accent"
                      >
                        {tool.name}
                      </a>
                    </h3>
                    <span class={badgeClass[tool.pricing]}>{tool.pricing}</span>
                  </div>
                  <p class="mb-2 text-sm text-gray-500 dark:text-gray-400">{tool.priceNote}</p>
                  <p class="text-sm leading-relaxed text-gray-700 dark:text-gray-300">{tool.why}</p>
                  {tool.related && tool.related.length > 0 && (
                    <div class="mt-auto border-t border-gray-100 pt-3 dark:border-gray-800">
                      <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500">
                        Panduan terkait
                      </p>
                      <ul class="space-y-1">
                        {tool.related.map((rel) => (
                          <li>
                            <a
                              href={rel.href}
                              class="text-sm font-medium text-primary hover:underline dark:text-accent"
                            >
                              {rel.title}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </article>
              ))}
            </div>
          </section>
        ))
      }

      <section id="panduan-review" class="scroll-mt-24 py-8">
        <h2 class="mb-2 text-2xl font-bold md:text-3xl">Panduan &amp; Review dari TeknoPulse</h2>
        <p class="mb-6 text-gray-600 dark:text-gray-400">
          Sudah punya kandidat tool? Dalami lewat panduan dan perbandingan yang sudah kami tulis
          berdasarkan pemakaian nyata.
        </p>
        <ul class="grid gap-3 md:grid-cols-2">
          {
            hubArticles.map((article) => (
              <li>
                <a
                  href={article.href}
                  class="group flex h-full items-start gap-3 rounded-lg border border-gray-200 bg-surface p-4 transition-shadow hover:shadow-md dark:border-gray-800 dark:bg-surface-dark"
                >
                  <span
                    class={`mt-0.5 shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ${
                      article.kind === 'Panduan'
                        ? 'bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300'
                        : article.kind === 'Review'
                          ? 'bg-violet-100 text-violet-800 dark:bg-violet-900/40 dark:text-violet-300'
                          : 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300'
                    }`}
                  >
                    {article.kind}
                  </span>
                  <span>
                    <span class="block font-semibold text-gray-900 transition-colors group-hover:text-primary dark:text-gray-100 dark:group-hover:text-accent">
                      {article.title}
                    </span>
                    <span class="mt-0.5 block text-sm text-gray-500 dark:text-gray-400">
                      {article.note}
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section
        class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-6 dark:border-gray-800 dark:bg-surface-dark"
      >
        <h2 class="mb-3 text-xl font-bold">Cara kami mengkurasi daftar ini</h2>
        <ul
          class="list-inside list-disc space-y-2 text-sm leading-relaxed text-gray-700 dark:text-gray-300"
        >
          <li>Tool dites langsung oleh tim, bukan sekadar kumpulan nama dari daftar lain.</li>
          <li>
            Dinilai dari kualitas output, dukungan bahasa Indonesia, nilai versus harga, dan
            kemudahan awal untuk mulai dipakai.
          </li>
          <li>Hanya tool yang masih aktif dan relevan per tanggal pembaruan yang masuk daftar.</li>
          <li>
            Harga dan fitur tool AI berubah cepat — selalu cek situs resmi sebelum berlangganan.
          </li>
        </ul>
      </section>

      <section class="py-10">
        <h2 class="mb-6 text-2xl font-bold md:text-3xl">Pertanyaan Umum</h2>
        <div class="space-y-3">
          {
            faqs.map((faq) => (
              <details class="rounded-lg border border-gray-200 bg-surface p-4 dark:border-gray-800 dark:bg-surface-dark">
                <summary class="cursor-pointer font-semibold">{faq.q}</summary>
                <p class="mt-2 text-sm leading-relaxed text-gray-700 dark:text-gray-300">{faq.a}</p>
              </details>
            ))
          }
        </div>
      </section>

      <section
        class="mb-8 rounded-lg border border-gray-200 bg-surface p-6 text-center dark:border-gray-800 dark:bg-surface-dark"
      >
        <h2 class="mb-2 text-xl font-bold">Ikuti Perkembangan AI Lebih Jauh</h2>
        <p class="mb-4 text-sm text-gray-600 dark:text-gray-400">
          Berita, analisis, dan update terbaru dunia AI untuk pengguna Indonesia.
        </p>
        <a
          href="/category/ai"
          class="btn-primary inline-block rounded-lg px-6 py-2.5 font-semibold text-white transition-colors hover:bg-primary-hover"
        >
          Lihat Berita AI Terbaru
        </a>
      </section>

      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    </div>

    <NewsletterCTA />
  </main>
</Layout>
