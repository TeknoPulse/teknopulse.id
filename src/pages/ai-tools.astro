  {
    title: 'Cara Memanfaatkan ChatGPT untuk Mempermudah Pekerjaan Sehari-hari',
    href: '/posts/cara-memanfaatkan-chatgpt-untuk-mempermudah-pekerjaan-sehari-hari/',
    kind: 'Panduan',
    note: 'Pola pemakaian ChatGPT untuk tugas kerja harian.',
  },
  {
    title: 'Cara Menggunakan ChatGPT untuk Kerja dan Belajar Sehari-hari',
    href: '/posts/cara-menggunakan-chatgpt-untuk-kerja-dan-belajar-sehari-hari/',
    kind: 'Panduan',
    note: 'Panduan awal untuk pelajar dan pekerja.',
  },
  {
    title: 'AI Agent Adalah: Definisi, Cara Kerja, Contoh 2026',
    href: '/posts/ai-agent-adalah/',
    kind: 'Konsep',
    note: 'Istilah yang makin sering muncul di deskripsi tool.',
  },
  {
    title: 'Bedanya AI Generatif dan AI Agent bagi Pengguna Awam',
    href: '/posts/bedanya-ai-generatif-dan-ai-agent/',
    kind: 'Konsep',
    note: 'Biar tidak salah pilih tool saat membaca label fitur.',
  },
