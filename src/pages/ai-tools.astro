---
import Layout from '../layouts/Layout.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';

const lastUpdated = '6 Oktober 2026';

type Tool = {
  name: string;
  url: string;
  pricing: 'Gratis' | 'Freemium' | 'Berbayar';
  priceNote: string;
  why: string;
  // Tautan internal ke panduan/review TeknoPulse yang mengupas tool ini
  // (TEKAA-66 D4.3 — hub /ai-tools/ menautkan artikel existing).
  related?: { title: string; href: string }[];
};

// Direktori ini adalah hub: selain daftar tool, ia menautkan semua artikel
// panduan/review terkait yang sudah ada di situs (TEKAA-66 D4.3). Tiga artikel
// harian ChatGPT lama bertopik & berjudul sama; yang dua judul kembar tidak
// ditautkan bersamaan agar tidak ada anchor duplikat.
type HubArticle = {
  title: string;
  href: string;
  kind: 'Panduan' | 'Review' | 'Konsep';
  note: string;
};

const hubArticles: HubArticle[] = [
  {
    title: '10 AI Terbaik 2026: untuk Kerja, Belajar, dan Berkarya',
    href: '/posts/ai-terbaik-2026/',
    kind: 'Review',
    note: 'Rangkuman pilihan utama kalau belum tahu mulai dari mana.',
  },
  {
    title: 'ChatGPT vs Gemini vs Claude: Bagus Mana? (Uji 2026)',
    href: '/posts/chatgpt-vs-gemini-vs-claude-2026/',
    kind: 'Review',
    note: 'Perbandingan langsung tiga asisten terpopuler.',
  },
  {
    title: 'Cara Bayar ChatGPT (GoPay, DANA, QRIS) + Solusi Pembayaran Gagal',
