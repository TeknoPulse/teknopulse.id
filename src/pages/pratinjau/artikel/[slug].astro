---
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticlePage from '../../../components/ArticlePage.astro';
import { getCategoryPosts, getRelatedPosts, sortPosts } from '../../../utils/related';

export const prerender = true;

export async function getStaticPaths() {
  const posts = sortPosts(await getCollection('posts', ({ data }) => !data.draft));
  const samples = posts.slice(0, 3);

  return samples.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      relatedPosts: getRelatedPosts(post, posts),
      categoryPosts: getCategoryPosts(post, posts),
    },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
  relatedPosts: CollectionEntry<'posts'>[];
  categoryPosts: CollectionEntry<'posts'>[];
}

const { post, relatedPosts, categoryPosts } = Astro.props;
---

<ArticlePage post={post} relatedPosts={relatedPosts} categoryPosts={categoryPosts} preview />
