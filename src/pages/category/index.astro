---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getAllCategories, getCategorySlug, getCategoryUrl } from '../../utils/categories';

// Single source of truth: categories.ts (slug, display name, description).
// Previously this derived the list from posts, which silently dropped
// categories that had no articles yet.
const posts = (await getCollection('posts')).filter((post) => !post.data.draft);

const categories = getAllCategories()
  .map((category) => ({
    ...category,
    count: posts.filter((post) => getCategorySlug(post.data.category) === category.slug).length,
  }))
  .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name));

const title = 'Semua Kategori';
const description = 'Jelajahi artikel TeknoPulse berdasarkan kategori.';
---

<Layout title={title} description={description} showBreadcrumbs={false} variant="real">
  <header class="border-b-2 border-rule-strong">
    <div class="wrap pt-8 pb-7 sm:pt-12">
      <p class="kicker text-cobalt">Jelajahi arsip / {categories.length} rubrik</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-6">
        <h1
          class="font-serif text-[clamp(3rem,9vw,7rem)] font-semibold leading-[0.8] tracking-headline"
        >
          Rubrik<span class="text-cobalt">.</span>
        </h1>
        <p class="max-w-sm pb-2 font-serif text-lg leading-snug text-ink-soft">
          Enam sudut pandang tetap: AI, Developer, Software, Automation, Experiments, dan Insights.
        </p>
      </div>
    </div>
  </header>

  <main class="wrap py-8 sm:py-10">
    <div class="grid gap-x-12 sm:grid-cols-2">
      {
        categories.map((category) => (
          <a
            href={getCategoryUrl(category.name)}
            class="group grid grid-cols-[3.5rem_1fr] gap-5 border-t border-rule py-6"
          >
            <span class="font-display text-4xl font-semibold leading-none text-cobalt">
              {String(category.count).padStart(2, '0')}
            </span>
            <span class="min-w-0">
              <span class="font-serif text-2xl font-semibold leading-tight transition-colors group-hover:text-cobalt">
                {category.name}
              </span>
              <span class="mt-1.5 block text-sm leading-relaxed text-ink-muted">
                {category.description}
              </span>
              <span class="kicker mt-3 block text-cobalt">Baca rubrik →</span>
            </span>
          </a>
        ))
      }
    </div>

    <div
      class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t-2 border-rule-strong pt-5"
    >
      <p class="text-xs text-ink-muted">{posts.length} artikel di seluruh rubrik</p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a href="/tags/" class="kicker text-cobalt hover:text-cobalt-dark">Semua topik →</a>
        <a href="/posts/" class="kicker text-cobalt hover:text-cobalt-dark">Arsip lengkap →</a>
      </div>
    </div>
  </main>
</Layout>
