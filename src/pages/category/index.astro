---
import Layout from '../../layouts/Layout.astro';
import { getAllCategories } from '../../utils/categories';

// Single source of truth: categories.ts (slug, display name, description).
// Previously this derived the list from posts, which silently dropped
// categories that had no articles yet.
const categories = getAllCategories().sort((a, b) => a.name.localeCompare(b.name));

const title = 'All Categories';
const description = 'Browse posts by category.';
---

<Layout title={title} description={description}>
  <main class="container mx-auto px-4 py-8">
    <h1 class="mb-8 text-4xl font-bold">{title}</h1>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        categories.map((category) => (
          <a
            href={`/category/${category.slug}`}
            class="block rounded-lg border border-gray-200 p-6 shadow-md transition-shadow duration-300 hover:shadow-lg dark:border-gray-700 dark:bg-gray-800"
          >
            <h2 class="mb-2 text-2xl font-semibold">{category.name}</h2>
            <p class="text-gray-600 dark:text-gray-400">{category.description}</p>
          </a>
        ))
      }
    </div>
  </main>
</Layout>
