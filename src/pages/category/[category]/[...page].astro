---
import { getCollection } from 'astro:content';
import { getAllCategories, getCategoryBySlug, getCategoryUrl } from '../../../utils/categories';
import Layout from '../../../layouts/Layout.astro';
import PostRow from '../../../components/PostRow.astro';
import Pagination from '../../../components/Pagination.astro';

export const prerender = true;

// Generate a page for EVERY registered category (from categories.ts), even
// ones with no posts yet, so header/footer links never 404. Slug is the
// canonical URL key (e.g. 'open-source'), not the raw enum value.
export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('posts'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

  return getAllCategories().flatMap((category) => {
    const categoryPosts = posts.filter((post) => post.data.category === category.name);
    return paginate(categoryPosts, {
      params: { category: category.slug },
      props: { categoryCount: categoryPosts.length },
      pageSize: 6,
    });
  });
}

const { page, categoryCount = 0 } = Astro.props;
const { category } = Astro.params;
const categoryMeta = getCategoryBySlug(category);
const categoryName = categoryMeta?.name ?? category;

// Judul unik per paginasi (TEKAA-3 P1-8); paginasi & kategori kosong
// noindex,follow dan dikeluarkan dari sitemap (scripts/sitemap-exclusions.mjs).
const isPaginated = page.currentPage > 1;
const isEmpty = categoryCount === 0;
const title = isPaginated ? `${categoryName} — Halaman ${page.currentPage}` : categoryName;
const description = `${categoryMeta?.description ?? `Berita dan artikel terbaru seputar ${categoryName}`}${
  isPaginated ? ` — Halaman ${page.currentPage}.` : ''
}`;
const robots = isPaginated || isEmpty ? 'noindex, follow' : 'index, follow';
const startIndex = (page.currentPage - 1) * page.size;
const otherCategories = getAllCategories().filter((item) => item.slug !== category);
---

<Layout title={title} description={description} robots={robots} showBreadcrumbs={false}>
  <header class="border-b-2 border-rule-strong">
    <div class="wrap pt-8 pb-7 sm:pt-12">
      <p class="kicker text-cobalt">
        Rubrik
        <span class="text-ink-muted">/ {categoryCount} artikel</span>
      </p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-6">
        <h1
          class="font-serif text-[clamp(3rem,9vw,7rem)] font-semibold leading-[0.8] tracking-headline"
        >
          {categoryName}<span class="text-cobalt">.</span>
        </h1>
        <p class="max-w-sm pb-2 font-serif text-lg leading-snug text-ink-soft">
          {categoryMeta?.description ?? `Berita dan artikel terbaru seputar ${categoryName}.`}
        </p>
      </div>
      <div class="mt-5 flex flex-wrap items-baseline gap-x-5 gap-y-1 border-t border-rule pt-3">
        <span class="kicker text-ink-muted">Halaman {page.currentPage} dari {page.lastPage}</span>
        <a href="/posts/" class="kicker ml-auto text-cobalt hover:text-cobalt-dark">
          Semua artikel →
        </a>
      </div>
    </div>
  </header>

  <main class="wrap py-8 sm:py-10">
    {
      isEmpty ? (
        <div class="border-y border-rule py-14 text-center">
          <p class="font-serif text-2xl text-ink">Belum ada artikel di rubrik ini.</p>
          <p class="mt-2 text-sm text-ink-muted">Cek lagi segera — atau jelajahi rubrik lain.</p>
          <a href="/category/" class="kicker mt-6 inline-block text-cobalt hover:text-cobalt-dark">
            Semua rubrik →
          </a>
        </div>
      ) : (
        <div>
          {page.data.map((post, index) => (
            <PostRow post={post} index={startIndex + index + 1} thumbnail />
          ))}
        </div>
      )
    }

    <Pagination
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      baseUrl={getCategoryUrl(categoryName)}
    />

    <section class="mt-12 border-t border-rule pt-5" aria-labelledby="rubrik-lain">
      <h2 id="rubrik-lain" class="kicker text-ink-muted">Rubrik lain</h2>
      <div class="mt-3 flex flex-wrap gap-x-1 gap-y-2">
        {
          otherCategories.map((item) => (
            <a
              href={getCategoryUrl(item.name)}
              class="kicker border border-rule px-3 py-2 text-ink-soft transition-colors hover:border-cobalt hover:text-cobalt"
            >
              {item.name}
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
