---
import Layout from '../../../layouts/Layout.astro';
import DemoNotice from '../../../components/DemoNotice.astro';
import ReadLaterButton from '../../../components/ReadLaterButton.astro';
import {
  articleUrl,
  articlesForIssue,
  formatDate,
  formatShortDate,
  getIssueArticles,
  getIssues,
  getTopic,
  issueUrl,
  padIssue,
  readingTime,
} from '../../../utils/edisi';
import type { IssueArticle } from '../../../utils/edisi';

export async function getStaticPaths() {
  const articles = await getIssueArticles();
  return articles.map((article) => ({
    params: {
      issue: padIssue(article.data.issue),
      slug: article.id.replace(/\.md$/, ''),
    },
    props: { article },
  }));
}

interface Props {
  article: IssueArticle;
}

const { article } = Astro.props;

const [issues, articles] = await Promise.all([getIssues(), getIssueArticles()]);
const issue = issues.find((item) => item.data.number === article.data.issue);

if (!issue) {
  throw new Error(`Artikel ${article.id} merujuk edisi ${article.data.issue} yang tidak ada.`);
}

const topic = getTopic(article.data.topic);
const { Content } = await article.render();
const minutes = readingTime(article.body);

const issueArticles = articlesForIssue(articles, article.data.issue);
const related = [
  ...articles.filter((item) => item.id !== article.id && item.data.topic === article.data.topic),
  ...issueArticles.filter(
    (item) => item.id !== article.id && item.data.topic !== article.data.topic
  ),
]
  .filter((item, index, list) => list.findIndex((entry) => entry.id === item.id) === index)
  .slice(0, 3);

const othersInIssue = issueArticles.filter((item) => item.id !== article.id).slice(0, 5);
---

<Layout
  title={`${article.data.title} — Edisi ${padIssue(article.data.issue)} (demo)`}
  description={`Konten demo: ${article.data.dek}`}
  showBreadcrumbs={false}
>
  <DemoNotice compact />

  <main>
    <article>
      <header class="border-b border-rule">
        <div class="wrap py-8 sm:py-11">
          <nav
            aria-label="Remah roti"
            class="kicker flex flex-wrap items-center gap-2 text-ink-muted"
          >
            <a href="/edisi/" class="hover:text-cobalt">Edisi</a>
            <span aria-hidden="true">/</span>
            <a href={issueUrl(issue.data.number)} class="hover:text-cobalt">
              No. {padIssue(issue.data.number)}
            </a>
            <span aria-hidden="true">/</span>
            <span class="text-ink">{topic.short}</span>
          </nav>

          <p class="kicker mt-7 text-cobalt">
            {article.data.kicker}
            <span class="mx-2 text-rule">/</span>
            {topic.label}
          </p>

          <h1
            class="headline-balance mt-3 max-w-5xl font-serif text-[clamp(2.5rem,6.2vw,4.9rem)] font-semibold leading-[0.94] tracking-headline"
          >
            {article.data.title}
          </h1>

          <p
            class="mt-5 max-w-3xl font-serif text-xl italic leading-snug text-ink-soft sm:text-2xl"
          >
            {article.data.dek}
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3 border-y border-rule py-3.5">
            <span class="kicker text-ink">
              Oleh <span class="font-semibold">{article.data.author}</span>
            </span>
            <time datetime={article.data.publishedAt.toISOString()} class="kicker text-ink-muted">
              {formatDate(article.data.publishedAt)}
            </time>
            <span class="kicker text-ink-muted">{minutes} menit baca</span>
            <span class="kicker border border-cobalt px-2 py-0.5 text-cobalt">Konten demo</span>
            <div class="ml-auto">
              <ReadLaterButton id={article.id} title={article.data.title} />
            </div>
          </div>
        </div>
      </header>

      <div class="wrap py-10 sm:py-14">
        <div class="grid gap-12 lg:grid-cols-12 lg:gap-0">
          <div class="lg:col-span-8 lg:pr-12">
            <div class="prose-news max-w-reading">
              <Content />
            </div>

            <footer class="mt-10 border-t border-rule pt-5">
              <p
                class="max-w-reading border-l-2 border-cobalt pl-4 text-sm leading-relaxed text-ink-muted"
              >
                Ini artikel contoh dari edisi demo TeknoPulse. Nama penulis, organisasi, dan
                peristiwa di dalamnya fiktif; teks ini tidak boleh dibaca sebagai berita sungguhan.
              </p>
              <div class="mt-6 flex flex-wrap items-center gap-4">
                <a
                  href={issueUrl(issue.data.number)}
                  class="kicker text-cobalt hover:text-cobalt-dark"
                >
                  ← Kembali ke edisi {padIssue(issue.data.number)}
                </a>
                <a href="/baca-nanti/" class="kicker text-ink-muted hover:text-cobalt">
                  Lihat Baca nanti →
                </a>
              </div>
            </footer>
          </div>

          <aside class="lg:col-span-4 lg:border-l lg:border-rule lg:pl-10">
            <div class="lg:sticky lg:top-24">
              <section aria-labelledby="dalam-edisi">
                <h2 id="dalam-edisi" class="kicker text-ink-muted">Dalam edisi ini</h2>
                <a href={issueUrl(issue.data.number)} class="group mt-2 block">
                  <span class="font-display text-4xl font-semibold leading-none text-cobalt">
                    No. {padIssue(issue.data.number)}
                  </span>
                  <span class="mt-1 block font-serif text-lg leading-tight group-hover:text-cobalt">
                    {issue.data.theme}
                  </span>
                  <time
                    datetime={issue.data.date.toISOString()}
                    class="mt-1 block text-xs text-ink-muted"
                  >
                    {formatDate(issue.data.date)}
                  </time>
                </a>
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">{issue.data.summary}</p>
              </section>

              {
                othersInIssue.length > 0 && (
                  <section class="mt-8 border-t border-rule pt-5" aria-labelledby="lain-di-edisi">
                    <h2 id="lain-di-edisi" class="kicker text-ink-muted">
                      Tulisan lain
                    </h2>
                    <ul class="mt-2 divide-y divide-rule">
                      {othersInIssue.map((item) => (
                        <li class="py-2.5">
                          <a
                            href={articleUrl(item)}
                            class="text-sm leading-snug text-ink-soft hover:text-cobalt"
                          >
                            {item.data.title}
                          </a>
                          <p class="mt-1 text-xs text-ink-muted">
                            {item.data.author}
                            <span class="mx-1.5 text-rule">/</span>
                            {formatShortDate(item.data.publishedAt)}
                          </p>
                        </li>
                      ))}
                    </ul>
                  </section>
                )
              }

              <p class="mt-8 border-l-2 border-cobalt pl-4 text-sm leading-relaxed text-ink-muted">
                Konten demo. Simpan artikel lain untuk dibaca nanti —
                <a href="/baca-nanti/" class="text-cobalt hover:text-cobalt-dark">buka daftar →</a>
              </p>
            </div>
          </aside>
        </div>

        {
          related.length > 0 && (
            <section class="mt-14 border-t-2 border-rule-strong pt-6" aria-labelledby="terkait">
              <div class="flex items-baseline justify-between">
                <h2 id="terkait" class="font-serif text-2xl font-semibold">
                  Artikel terkait
                </h2>
                <span class="kicker text-ink-muted">Dari edisi demo</span>
              </div>
              <div class="mt-4 grid gap-x-8 gap-y-6 sm:grid-cols-3">
                {related.map((item) => {
                  const relatedTopic = getTopic(item.data.topic);
                  return (
                    <article class="border-t border-rule pt-4">
                      <p class="kicker text-cobalt">
                        {relatedTopic.label}
                        <span class="mx-1.5 text-rule">/</span>
                        No. {padIssue(item.data.issue)}
                      </p>
                      <h3 class="mt-2 font-serif text-xl font-semibold leading-tight">
                        <a href={articleUrl(item)} class="transition-colors hover:text-cobalt">
                          {item.data.title}
                        </a>
                      </h3>
                      <p class="line-clamp-3 mt-2 text-sm leading-relaxed text-ink-muted">
                        {item.data.dek}
                      </p>
                      <div class="mt-3">
                        <ReadLaterButton id={item.id} title={item.data.title} compact />
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          )
        }
      </div>
    </article>
  </main>
</Layout>
