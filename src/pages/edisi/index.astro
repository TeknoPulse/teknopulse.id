---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import {
  arrangeIssue,
  articleUrl,
  formatDate,
  getIssueArticles,
  getIssues,
  getTopic,
  issueUrl,
  padIssue,
  topics,
  topicUrl,
} from '../../utils/edisi';

const issues = await getIssues();
const articles = await getIssueArticles();

const cards = issues.map((issue, index) => ({
  issue,
  current: index === 0,
  ...arrangeIssue(issue, articles),
}));

const topicCounts = topics
  .map((topic) => ({
    ...topic,
    count: articles.filter((article) => article.data.topic === topic.slug).length,
  }))
  .filter((topic) => topic.count > 0);
---

<Layout
  title="Edisi — TeknoPulse"
  description="Arsip tiga edisi percontohan TeknoPulse: laporan utama, pilihan editor, dan ringkas tentang teknologi. Semua konten demo."
  showBreadcrumbs={false}
>
  <DemoNotice compact />

  <header class="border-b-2 border-rule-strong">
    <div class="wrap pt-8 pb-7 sm:pt-12">
      <p class="kicker text-cobalt">Arsip</p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-6">
        <h1
          class="font-serif text-[clamp(3.6rem,10vw,7.5rem)] font-semibold leading-[0.8] tracking-headline"
        >
          Edisi<span class="text-cobalt">.</span>
        </h1>
        <p class="max-w-md pb-2 font-serif text-lg leading-snug text-ink-soft">
          Tiga edisi percontohan, disusun surut dari yang terbaru. Setiap edisi punya laporan utama,
          pilihan editor, dan ringkas — semuanya contoh untuk desain.
        </p>
      </div>
    </div>
  </header>

  <main class="wrap py-10 sm:py-14">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-0">
      <div class="lg:col-span-8 lg:pr-12">
        <div class="divide-y divide-rule">
          {
            cards.map(({ issue, current, cover, all }) => (
              <article class="grid gap-6 py-9 first:pt-0 sm:grid-cols-[8.5rem_1fr] sm:gap-8">
                <div>
                  <p class="kicker text-ink-muted">Edisi</p>
                  <p class="font-display text-[4.6rem] font-semibold leading-[0.75] text-cobalt">
                    {padIssue(issue.data.number)}
                  </p>
                  <time
                    datetime={issue.data.date.toISOString()}
                    class="mt-3 block max-w-[8rem] font-serif text-sm leading-tight text-ink-soft"
                  >
                    {formatDate(issue.data.date)}
                  </time>
                  {current && (
                    <span class="kicker mt-3 inline-block border border-cobalt px-2 py-0.5 text-cobalt">
                      Edisi ini
                    </span>
                  )}
                </div>

                <div>
                  <h2 class="font-serif text-[clamp(1.6rem,3vw,2.4rem)] font-semibold leading-[1.05]">
                    <a
                      href={issueUrl(issue.data.number)}
                      class="transition-colors hover:text-cobalt"
                    >
                      {issue.data.theme}
                    </a>
                  </h2>
                  <p class="mt-3 max-w-2xl font-serif text-lg leading-snug text-ink-soft">
                    {issue.data.summary}
                  </p>

                  {cover && (
                    <p class="mt-4 text-sm leading-relaxed text-ink-muted">
                      <span class="kicker text-ink-muted">Laporan utama</span>
                      <span class="mx-2 text-rule">/</span>
                      <a href={articleUrl(cover)} class="text-ink-soft hover:text-cobalt">
                        {cover.data.title}
                      </a>
                    </p>
                  )}

                  <div class="mt-5 flex flex-wrap items-center gap-4 border-t border-rule pt-4">
                    <a
                      href={issueUrl(issue.data.number)}
                      class="kicker text-cobalt hover:text-cobalt-dark"
                    >
                      Baca edisi →
                    </a>
                    <span class="kicker text-ink-muted">{all.length} tulisan</span>
                    <span class="kicker text-ink-muted">
                      {[...new Set(all.map((article) => getTopic(article.data.topic).short))].join(
                        ' · '
                      )}
                    </span>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <aside class="lg:col-span-4 lg:border-l lg:border-rule lg:pl-10">
        <section aria-labelledby="arsip-topik">
          <h2 id="arsip-topik" class="border-b border-rule pb-2 font-serif text-2xl font-semibold">
            Rubrik
          </h2>
          <ul class="divide-y divide-rule">
            {
              topicCounts.map((topic) => (
                <li>
                  <a
                    href={topicUrl(topic.slug)}
                    class="group flex items-baseline justify-between gap-4 py-3 hover:text-cobalt"
                  >
                    <span class="font-serif text-lg">{topic.label}</span>
                    <span class="kicker text-ink-muted">{topic.count}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-8 border-t-2 border-rule-strong pt-5" aria-labelledby="arsip-cari">
          <h2 id="arsip-cari" class="font-serif text-xl font-semibold">Cari artikel</h2>
          <form
            action="/cari/"
            method="get"
            role="search"
            class="mt-3 flex border-b border-rule-strong"
          >
            <label for="archive-search" class="sr-only">Cari artikel demo</label>
            <input
              id="archive-search"
              name="q"
              type="search"
              placeholder="Kata kunci atau penulis…"
              class="w-full min-w-0 bg-transparent py-2 text-sm text-ink placeholder:text-ink-muted"
            />
            <button type="submit" class="kicker px-2 text-cobalt hover:text-cobalt-dark"
              >Cari</button
            >
          </form>
          <p class="mt-4 text-sm leading-relaxed text-ink-muted">
            Ingin menyimpan tulisan untuk nanti?
            <a href="/baca-nanti/" class="text-cobalt hover:text-cobalt-dark">Buka Baca nanti</a>.
            Daftar tersimpan hanya di peramban ini.
          </p>
        </section>
      </aside>
    </div>
  </main>
</Layout>
