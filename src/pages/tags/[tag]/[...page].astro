---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';

export const prerender = true;

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('posts'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

  const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];

  return allTags.flatMap((tag) => {
    const tagPosts = posts.filter((post) => post.data.tags.includes(tag));
    return paginate(tagPosts, {
      params: { tag: tag.toLowerCase().replace(/\s+/g, '-') },
      // tagLabel = nama tag asli (bukan versi slug); tagCount untuk noindex
      // halaman tipis (TEKAA-3 P1-8).
      props: { tagLabel: tag, tagCount: tagPosts.length },
      pageSize: 6,
    });
  });
}

const { page, tagLabel, tagCount = 0 } = Astro.props;
const { tag } = Astro.params;
const tagName = tagLabel ?? tag.replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase());

// Judul unik per paginasi + noindex untuk halaman tipis/paginasi
// (TEKAA-3 P1-8): tag ≤1 artikel dan halaman ≥2 tidak punya nilai unik —
// dikeluarkan dari sitemap (scripts/sitemap-exclusions.mjs) dan noindex.
const isPaginated = page.currentPage > 1;
const isThin = tagCount <= 1;
const title = isPaginated ? `${tagName} — Halaman ${page.currentPage}` : tagName;
const description = `Kumpulan artikel TeknoPulse dengan topik "${tagName}"${
  isPaginated ? `, halaman ${page.currentPage}` : ''
}.`;
const robots = isPaginated || isThin ? 'noindex, follow' : 'index, follow';
---

<Layout title={title} description={description} robots={robots}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="mb-4 text-4xl font-bold">#{tagName}</h1>
      <p class="text-gray-600 dark:text-gray-400">
        Kumpulan artikel dengan topik "{tagName}"
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      baseUrl={`/tags/${tag}`}
    />
  </main>
</Layout>
