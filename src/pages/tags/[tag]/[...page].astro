---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import PostCard from '../../../components/PostCard.astro';
import Pagination from '../../../components/Pagination.astro';
import { getTagUrl, slugifyTag } from '../../../utils/urls.mjs';
import { isThinTag, mergeTagEntries } from '../../../utils/tags.mjs';

export const prerender = true;

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('posts'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

  // Dedup per SLUG, bukan per tag mentah (TEKAA-377): 'NVIDIA' dan 'Nvidia'
  // adalah satu topik, bukan dua halaman yang saling menimpa.
  const entries = mergeTagEntries(posts.map((post) => post.data.tags));

  return entries.flatMap((entry) => {
    const tagPosts = posts.filter((post) =>
      (post.data.tags ?? []).some((t) => slugifyTag(t) === entry.slug)
    );
    return paginate(tagPosts, {
      params: { tag: entry.slug },
      // tagLabel = label tampilan pilihan SSOT; tagCount untuk noindex
      // halaman tipis — aturannya sama dengan filter sitemap (src/utils/tags.mjs).
      props: { tagLabel: entry.label, tagCount: tagPosts.length },
      pageSize: 6,
    });
  });
}

const { page, tagLabel, tagCount = 0 } = Astro.props;
const { tag } = Astro.params;
const tagName = tagLabel ?? tag.replace(/-/g, ' ').replace(/\b\w/g, (l) => l.toUpperCase());

// Judul unik per paginasi + noindex untuk halaman tipis/paginasi
// (TEKAA-3 P1-8, dinaikkan ke ≤2 artikel di TEKAA-377): halaman ≥2 dan tag
// tipis tidak punya nilai unik — dikeluarkan dari sitemap lewat aturan yang
// sama (src/utils/tags.mjs) dan noindex di sini.
const isPaginated = page.currentPage > 1;
const isThin = isThinTag(tagCount);
const title = isPaginated ? `${tagName} — Halaman ${page.currentPage}` : tagName;
const description = `Kumpulan artikel TeknoPulse dengan topik "${tagName}"${
  isPaginated ? `, halaman ${page.currentPage}` : ''
}.`;
const robots = isPaginated || isThin ? 'noindex, follow' : 'index, follow';
---

<Layout title={title} description={description} robots={robots}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="mb-4 text-4xl font-bold">#{tagName}</h1>
      <p class="text-gray-600 dark:text-gray-400">
        Kumpulan artikel dengan topik "{tagName}"
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination
      currentPage={page.currentPage}
      totalPages={page.lastPage}
      baseUrl={getTagUrl(tag)}
    />
  </main>
</Layout>
