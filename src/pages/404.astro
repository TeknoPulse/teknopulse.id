---
import Layout from '../layouts/Layout.astro';

// Halaman 404 (TEKAA-3 P0-1). Tanpa file ini Cloudflare Pages menjalankan
// SPA-fallback ke index.html — URL apa pun balik HTTP 200 dengan konten
// homepage (soft-404). `dist/404.html` otomatis disajikan Pages dengan
// status 404 untuk path yang tidak dikenal.
const title = 'Halaman Tidak Ditemukan';
const description =
  'Halaman yang Anda cari tidak ditemukan atau sudah dipindahkan. Jelajahi berita teknologi terbaru di TeknoPulse.';
---

<Layout title={title} description={description} showBreadcrumbs={false}>
  <main class="wrap flex min-h-[60vh] flex-col justify-center py-14 sm:py-20">
    <p class="kicker text-cobalt">Error 404 / Halaman tidak ditemukan</p>
    <div class="mt-3 border-y-2 border-rule-strong py-8 sm:py-10">
      <p class="font-display text-[clamp(5rem,17vw,11rem)] font-semibold leading-[0.75] text-rule">
        404
      </p>
      <h1
        class="headline-balance mt-4 max-w-3xl font-serif text-[clamp(2.2rem,5vw,4rem)] font-semibold leading-[0.94] tracking-headline"
      >
        Alamat ini tidak ada<span class="text-cobalt">.</span>
      </h1>
      <p class="mt-4 max-w-xl font-serif text-xl leading-snug text-ink-soft">
        Halaman yang Anda buka mungkin sudah dipindahkan atau tautannya salah ketik. Mulai lagi dari
        beranda, atau cari artikel yang Anda ingat.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href="/"
          class="kicker inline-flex items-center gap-2 bg-ink px-5 py-3 text-paper-light transition-colors hover:bg-cobalt"
        >
          Ke beranda <span aria-hidden="true">→</span>
        </a>
        <a
          href="/search/"
          class="kicker inline-flex items-center gap-2 border border-rule px-5 py-3 text-ink-soft transition-colors hover:border-cobalt hover:text-cobalt"
        >
          Cari artikel
        </a>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap items-baseline gap-x-5 gap-y-1">
      <span class="kicker text-ink-muted">Atau jelajahi</span>
      <a href="/posts/" class="kicker text-cobalt hover:text-cobalt-dark">Arsip artikel →</a>
      <a href="/category/" class="kicker text-cobalt hover:text-cobalt-dark">Semua rubrik →</a>
      <a href="/tags/" class="kicker text-cobalt hover:text-cobalt-dark">Topik →</a>
    </div>
  </main>
</Layout>
