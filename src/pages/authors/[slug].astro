---
// src/pages/authors/[slug].astro — halaman profil penulis (TEKAA-5).
// Sumber data: src/utils/authors.ts. Byline artikel yang cocok jadi tautan
// ke halaman ini dan JSON-LD Article.author mendapat `url` ke sini.
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostRow from '../../components/PostRow.astro';
import { authors, getAuthor, type Author } from '../../utils/authors';
import { site } from '../../config';

export async function getStaticPaths() {
  const allPosts = await getCollection('posts');
  const validPosts = allPosts.filter((post) => !post.data.draft);

  // Sort posts once
  validPosts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

  return authors.map((author) => {
    // Filter posts for this specific author
    const authorPosts = validPosts.filter(
      (post) => getAuthor(post.data.author)?.slug === author.slug
    );

    return {
      params: { slug: author.slug },
      props: { author, posts: authorPosts },
    };
  });
}

interface Props {
  author: Author;
  posts: CollectionEntry<'posts'>[];
}

const { author, posts } = Astro.props;

// JSON-LD Person untuk halaman profil
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  jobTitle: author.role,
  description: author.bio,
  url: new URL(`/authors/${author.slug}`, site.url).href,
  ...(author.links && author.links.length > 0
    ? { sameAs: author.links.map((link) => link.url) }
    : {}),
  ...(posts.length > 0
    ? {
        worksFor: {
          '@type': 'Organization',
          name: site.name,
          url: site.url,
        },
      }
    : {}),
};
---

<Layout title={author.name} description={author.bio} showBreadcrumbs={false}>
  <header class="border-b-2 border-rule-strong">
    <div class="wrap pt-8 pb-7 sm:pt-12">
      <p class="kicker text-cobalt">Profil penulis</p>
      <h1
        class="mt-2 font-serif text-[clamp(2.6rem,6vw,4.6rem)] font-semibold leading-[0.9] tracking-headline"
      >
        {author.name}
      </h1>
      <p class="kicker mt-4 text-cobalt">{author.role}</p>
      <p class="mt-4 max-w-2xl font-serif text-lg leading-snug text-ink-soft">{author.bio}</p>

      {
        author.links && author.links.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
            {author.links.map((link) => (
              <a
                href={link.url}
                class="kicker text-ink-soft transition-colors hover:text-cobalt"
                rel="noopener noreferrer"
              >
                {link.label} →
              </a>
            ))}
          </div>
        )
      }
    </div>
  </header>

  <main class="wrap py-8 sm:py-12">
    <section aria-label={`Artikel oleh ${author.name}`}>
      <div
        class="flex flex-wrap items-baseline justify-between gap-4 border-b-2 border-rule-strong pb-3"
      >
        <h2 class="font-serif text-2xl font-semibold">Artikel</h2>
        <span class="kicker text-ink-muted">{posts.length} tulisan</span>
      </div>

      {
        posts.length > 0 ? (
          <div>
            {posts.map((post) => (
              <PostRow post={post} thumbnail />
            ))}
          </div>
        ) : (
          <p class="py-10 text-ink-muted">Belum ada artikel yang diterbitkan.</p>
        )
      }
    </section>
  </main>
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
</Layout>
