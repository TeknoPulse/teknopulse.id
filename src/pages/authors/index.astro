---
// src/pages/authors/index.astro — daftar penulis (TEKAA-5).
import Layout from '../../layouts/Layout.astro';
import { authors } from '../../utils/authors';
---

<Layout title="Para Penulis" description="Penulis dan kontributor TeknoPulse.">
  <main class="container mx-auto px-4 py-8">
    <header class="mx-auto mb-10 max-w-4xl">
      <h1 class="text-4xl font-bold">Para Penulis</h1>
      <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-400">
        Tim penulis dan kontributor di balik TeknoPulse.
      </p>
    </header>

    <section class="mx-auto max-w-4xl" aria-label="Daftar penulis">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        {
          authors.map((author) => (
            <a
              href={`/authors/${author.slug}`}
              class="card card-elevated block rounded-lg border p-6 transition-shadow hover:shadow-md"
            >
              <h2 class="text-xl font-semibold">{author.name}</h2>
              <p class="mt-1 text-sm font-medium uppercase tracking-wide text-primary">
                {author.role}
              </p>
              <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">{author.bio}</p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
