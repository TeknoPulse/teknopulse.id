---
// src/pages/authors/index.astro — daftar penulis (TEKAA-5).
import Layout from '../../layouts/Layout.astro';
import { authors } from '../../utils/authors';
import { getAuthorUrl } from '../../utils/urls.mjs';
---

<Layout
  title="Para Penulis"
  description="Penulis dan kontributor TeknoPulse."
  showBreadcrumbs={false}
>
  <header class="border-b-2 border-rule-strong">
    <div class="wrap pt-8 pb-7 sm:pt-12">
      <p class="kicker text-cobalt">Redaksi / {authors.length} penulis</p>
      <h1
        class="mt-2 font-serif text-[clamp(3rem,8vw,6rem)] font-semibold leading-[0.85] tracking-headline"
      >
        Para penulis<span class="text-cobalt">.</span>
      </h1>
      <p class="mt-5 max-w-2xl font-serif text-lg leading-snug text-ink-soft">
        Tim penulis dan kontributor di balik TeknoPulse.
      </p>
    </div>
  </header>

  <main class="wrap py-8 sm:py-12">
    <section aria-label="Daftar penulis">
      <div class="grid gap-x-12 md:grid-cols-2">
        {
          authors.map((author) => (
            <a
              href={getAuthorUrl(author.slug)}
              class="group border-t border-rule py-6 transition-colors hover:text-cobalt"
            >
              <h2 class="font-serif text-2xl font-semibold leading-tight">{author.name}</h2>
              <p class="kicker mt-2 text-cobalt">{author.role}</p>
              <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-muted">{author.bio}</p>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</Layout>
