---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import PostRow from '../components/PostRow.astro';
import { site } from '../config';
import { getAllCategories, getCategorySlug, getCategoryUrl } from '../utils/categories';
import { calculateReadingTime } from '../utils/readingTime';
import { coverAlt } from '../utils/coverAlt';
import { getPostUrl } from '../utils/urls.mjs';
import { formatDate, formatShortDate } from '../utils/edisi';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const [lead, ...rest] = posts;

if (!lead) {
  throw new Error('Tidak ada artikel terbit di src/content/posts.');
}

const picks = rest.slice(0, 2);
const briefs = rest.slice(2, 5);
const recent = posts.slice(0, 12);

const categories = getAllCategories()
  .map((category) => ({
    ...category,
    count: posts.filter((post) => getCategorySlug(post.data.category) === category.slug).length,
  }))
  .filter((category) => category.count > 0)
  .sort((a, b) => b.count - a.count);

const recentCategories = categories
  .map((category) => ({
    ...category,
    count: recent.filter((post) => getCategorySlug(post.data.category) === category.slug).length,
  }))
  .filter((category) => category.count > 0);

const leadMinutes = lead.data.readingTime ?? calculateReadingTime(lead.body);
---

<Layout
  title={site.homeTitle}
  description={site.homeDescription}
  showBreadcrumbs={false}
  variant="real"
>
  <header class="border-b-2 border-rule-strong">
    <div class="wrap pt-5 pb-4 sm:pt-7">
      <div class="kicker flex items-center justify-between gap-4 text-ink-muted">
        <span>Surat kabar teknologi</span>
        <span class="text-cobalt">Arsip terbuka</span>
      </div>

      <div
        class="mt-4 grid grid-cols-1 items-end gap-5 border-y border-rule py-5 sm:grid-cols-[8rem_1fr_10rem] sm:gap-6 sm:py-7"
      >
        <div class="hidden sm:block">
          <p class="kicker text-ink-muted">Arsip</p>
          <p class="mt-1 font-display text-6xl font-semibold leading-[0.8] text-cobalt">
            {posts.length}
          </p>
          <p class="kicker mt-1 text-ink-muted">Artikel</p>
        </div>

        <div class="text-center">
          <p
            class="display-line text-[clamp(3.1rem,10.5vw,7.6rem)] font-semibold leading-[0.8] tracking-headline text-ink"
          >
            TeknoPulse<span class="text-cobalt">.</span>
          </p>
          <p class="mt-3 font-serif text-base italic leading-snug text-ink-soft sm:text-lg">
            Teknologi, manusia, dan keputusan yang kita ambil.
          </p>
        </div>

        <div class="hidden text-right sm:block">
          <p class="kicker text-ink-muted">Terakhir</p>
          <time
            datetime={lead.data.publishedAt.toISOString()}
            class="mt-1 block font-serif text-xl leading-tight"
          >
            {formatDate(lead.data.publishedAt)}
          </time>
        </div>
      </div>

      <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <p class="kicker text-ink-muted">AI · Software · Developer · Automation</p>
        <p class="kicker text-ink-muted sm:hidden">{formatShortDate(lead.data.publishedAt)}</p>
      </div>
    </div>
  </header>

  <main>
    <section class="wrap py-9 sm:py-12" aria-labelledby="artikel-utama">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-0">
        <div class="lg:col-span-8 lg:pr-10">
          <div class="h-0.5 w-14 bg-cobalt" aria-hidden="true"></div>
          <p class="kicker mt-3 text-cobalt">
            Artikel terbaru <span class="mx-1.5 text-rule">/</span>
            {
              categories.find((category) => category.slug === getCategorySlug(lead.data.category))
                ?.name ?? lead.data.category
            }
          </p>

          <h1
            id="artikel-utama"
            class="headline-balance mt-3 font-serif text-[clamp(2.5rem,5.6vw,4.9rem)] font-semibold leading-[0.94] tracking-headline"
          >
            <a href={getPostUrl(lead.slug)} class="transition-colors hover:text-cobalt">
              {lead.data.title}
            </a>
          </h1>

          <p class="mt-5 max-w-2xl font-serif text-xl leading-snug text-ink-soft sm:text-2xl">
            {lead.data.summary}
          </p>

          {
            lead.data.coverImage && (
              <div class="mt-7 overflow-hidden">
                <Image
                  src={lead.data.coverImage}
                  alt={coverAlt(lead)}
                  width={1200}
                  height={675}
                  loading="eager"
                  fetchpriority="high"
                  class="w-full object-cover"
                />
              </div>
            )
          }

          <div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 border-t border-rule pt-4">
            <span class="kicker text-ink">{lead.data.author}</span>
            <time datetime={lead.data.publishedAt.toISOString()} class="kicker text-ink-muted">
              {formatDate(lead.data.publishedAt)}
            </time>
            <span class="kicker text-ink-muted">{leadMinutes} menit baca</span>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-4">
            <a
              href={getPostUrl(lead.slug)}
              class="kicker inline-flex items-center gap-2 bg-ink px-5 py-3 text-paper-light transition-colors hover:bg-cobalt"
            >
              Baca artikel
              <span aria-hidden="true">→</span>
            </a>
            <a
              href={getCategoryUrl(lead.data.category)}
              class="kicker text-ink-muted transition-colors hover:text-cobalt"
            >
              Semua {lead.data.category}
            </a>
          </div>
        </div>

        <aside
          class="lg:col-span-4 lg:border-l lg:border-rule lg:pl-10"
          aria-labelledby="pilihan-redaksi"
        >
          <div class="flex items-baseline justify-between border-b-2 border-rule-strong pb-2">
            <h2 id="pilihan-redaksi" class="font-serif text-2xl font-semibold">Pilihan Redaksi</h2>
            <span class="kicker text-ink-muted">Arsip</span>
          </div>

          <ol class="divide-y divide-rule">
            {
              picks.map((post, index) => (
                <li class="py-5">
                  <div class="flex gap-4">
                    <span class="font-display text-3xl leading-none text-cobalt">
                      {String(index + 1).padStart(2, '0')}
                    </span>
                    <div>
                      <a
                        href={getCategoryUrl(post.data.category)}
                        class="kicker text-cobalt transition-colors hover:text-cobalt-dark"
                      >
                        {post.data.category}
                      </a>
                      <h3 class="mt-1.5 font-serif text-[1.4rem] font-semibold leading-[1.12]">
                        <a href={getPostUrl(post.slug)} class="transition-colors hover:text-cobalt">
                          {post.data.title}
                        </a>
                      </h3>
                      <p class="line-clamp-2 mt-2 text-sm leading-relaxed text-ink-muted">
                        {post.data.summary}
                      </p>
                      <p class="mt-3 text-xs text-ink-muted">
                        {formatShortDate(post.data.publishedAt)}
                      </p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
        </aside>
      </div>
    </section>

    <section class="wrap border-t-2 border-rule-strong py-9 sm:py-12">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-0">
        <div class="lg:col-span-7 lg:pr-10">
          <div class="flex items-baseline justify-between border-b border-rule pb-2">
            <h2 class="font-serif text-2xl font-semibold">Terbaru</h2>
            <span class="kicker text-ink-muted">Langsung dari arsip</span>
          </div>

          <ul class="divide-y divide-rule">
            {
              briefs.map((post, index) => (
                <li class="grid gap-3 py-5 sm:grid-cols-[2rem_1fr] sm:gap-4">
                  <span class="font-display text-xl leading-none text-cobalt">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <a
                      href={getCategoryUrl(post.data.category)}
                      class="kicker text-cobalt transition-colors hover:text-cobalt-dark"
                    >
                      {post.data.category}
                    </a>
                    <h3 class="mt-1 font-serif text-xl font-semibold leading-tight sm:text-2xl">
                      <a href={getPostUrl(post.slug)} class="transition-colors hover:text-cobalt">
                        {post.data.title}
                      </a>
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-ink-muted">{post.data.summary}</p>
                    <p class="mt-3 text-xs text-ink-muted">
                      {formatShortDate(post.data.publishedAt)}
                    </p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <aside
          class="lg:col-span-5 lg:border-l lg:border-rule lg:pl-10"
          aria-labelledby="rubrik-arsip"
        >
          <div class="flex items-baseline justify-between border-b border-rule pb-2">
            <h2 id="rubrik-arsip" class="font-serif text-2xl font-semibold">Rubrik</h2>
            <a href="/category/" class="kicker text-cobalt hover:text-cobalt-dark">
              Semua rubrik →
            </a>
          </div>

          <div class="divide-y divide-rule">
            {
              categories.map((category) => (
                <a href={getCategoryUrl(category.name)} class="group flex gap-5 py-5">
                  <span class="font-display text-5xl font-semibold leading-[0.8] text-cobalt">
                    {String(category.count).padStart(2, '0')}
                  </span>
                  <span class="min-w-0">
                    <span class="kicker text-ink-muted">Artikel</span>
                    <span class="mt-1 block font-serif text-xl font-semibold leading-tight transition-colors group-hover:text-cobalt">
                      {category.name}
                    </span>
                    <span class="line-clamp-2 mt-1.5 block text-sm leading-relaxed text-ink-muted">
                      {category.description}
                    </span>
                  </span>
                </a>
              ))
            }
          </div>

          <div class="mt-6 border-t border-rule pt-5">
            <h2 class="font-serif text-xl font-semibold">Cari di arsip</h2>
            <form
              action="/search/"
              method="get"
              role="search"
              class="mt-3 flex border-b border-rule-strong"
            >
              <label for="home-search" class="sr-only">Cari artikel</label>
              <input
                id="home-search"
                name="q"
                type="search"
                placeholder="Kata kunci atau topik…"
                class="w-full min-w-0 bg-transparent py-2 text-sm text-ink placeholder:text-ink-muted"
              />
              <button type="submit" class="kicker px-2 text-cobalt hover:text-cobalt-dark">
                Cari
              </button>
            </form>
            <p class="mt-3 text-xs leading-relaxed text-ink-muted">
              Pencarian mencakup seluruh {posts.length} artikel yang sudah terbit.
            </p>
            <a href="/posts/" class="kicker mt-3 inline-block text-cobalt hover:text-cobalt-dark">
              Lihat semua artikel →
            </a>
          </div>
        </aside>
      </div>
    </section>

    <section
      class="border-y border-rule bg-paper-deep/40 py-9 sm:py-12"
      aria-labelledby="indeks-terbaru"
    >
      <div class="wrap">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="kicker text-cobalt">Filter rubrik</p>
            <h2 id="indeks-terbaru" class="mt-1 font-serif text-3xl font-semibold sm:text-4xl">
              Indeks terbaru
            </h2>
          </div>
          <p class="max-w-sm text-sm leading-relaxed text-ink-muted">
            Pilih rubrik untuk menyaring daftar.
            <span id="filter-count" class="font-medium text-ink" aria-live="polite">
              {recent.length} tulisan
            </span>
          </p>
        </div>

        <div
          class="mt-5 flex flex-wrap gap-x-1 gap-y-2 border-y border-rule py-3"
          role="group"
          aria-label="Filter artikel berdasarkan rubrik"
        >
          <button
            type="button"
            class="filter-chip"
            data-topic-filter="all"
            aria-pressed="true"
            aria-controls="recent-index"
          >
            Semua
            <span class="ml-1 text-ink-muted">{recent.length}</span>
          </button>
          {
            recentCategories.map((category) => (
              <button
                type="button"
                class="filter-chip"
                data-topic-filter={category.slug}
                aria-pressed="false"
                aria-controls="recent-index"
              >
                {category.name}
                <span class="ml-1 text-ink-muted">{category.count}</span>
              </button>
            ))
          }
        </div>

        <div id="recent-index" class="mt-2">
          {recent.map((post, index) => <PostRow post={post} index={index + 1} />)}
        </div>

        <p
          id="filter-empty"
          class="hidden py-10 text-center font-serif text-xl text-ink-muted"
          role="status"
        >
          Belum ada tulisan untuk rubrik ini di daftar terbaru.
        </p>

        <div
          class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-rule pt-5"
        >
          <p class="text-xs text-ink-muted">
            {recent.length} tulisan terbaru · {posts.length} artikel di arsip
          </p>
          <a href="/posts/" class="kicker text-cobalt hover:text-cobalt-dark"> Arsip lengkap → </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-topic-filter]'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-article-topic]'));
  const count = document.getElementById('filter-count');
  const empty = document.getElementById('filter-empty');

  const applyFilter = (topic: string) => {
    let visible = 0;

    rows.forEach((row) => {
      const show = topic === 'all' || row.dataset.articleTopic === topic;
      row.hidden = !show;
      if (show) visible += 1;
    });

    buttons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.topicFilter === topic));
    });

    if (count) count.textContent = `${visible} tulisan`;
    if (empty) empty.classList.toggle('hidden', visible > 0);
  };

  buttons.forEach((button) => {
    button.addEventListener('click', () => applyFilter(button.dataset.topicFilter ?? 'all'));
  });
</script>
