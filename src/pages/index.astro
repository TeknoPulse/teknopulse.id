---
import Layout from '../layouts/Layout.astro';
import { getCategoryLabel, getCategoryToken } from '../utils/categories';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import HeroSection from '../components/HeroSection.astro';
import PostCard from '../components/PostCard.astro';
import CategoryPills from '../components/CategoryPills.astro';
import TrendingList from '../components/TrendingList.astro';
import EditorsPicks from '../components/EditorsPicks.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

// Hero: pick featured post or latest as lead, next 4 as secondary
const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];
const heroSecondary = posts.filter((p) => p.slug !== featuredPost.slug).slice(0, 4);

// Latest articles: skip the ones already shown in hero
const heroSlugs = new Set([featuredPost.slug, ...heroSecondary.map((p) => p.slug)]);
const latestPosts = posts.filter((p) => !heroSlugs.has(p.slug)).slice(0, 7);

// Trending: recent posts from last 14 days
const trendingPosts = posts
  .filter(
    (post) => (new Date().getTime() - post.data.publishedAt.getTime()) / (1000 * 60 * 60 * 24) < 14
  )
  .slice(0, 5);

const editorsPicks = posts.slice(0, 3);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))];
---

<Layout>
  <main class="min-h-screen">
    <!-- Hero: Lead Story + Secondary Articles -->
    <section class="py-8 lg:py-12">
      <div class="container mx-auto px-4">
        <HeroSection leadPost={featuredPost} secondaryPosts={heroSecondary} />
      </div>
    </section>

    <!-- Category Pills -->
    <CategoryPills />

    <!-- Latest Articles - Asymmetric Grid: 1 big + 3-col medium -->
    <section class="py-12">
      <div class="container mx-auto px-4">
        <div class="mb-8 flex items-center justify-between">
          <h2 class="text-3xl font-bold text-text-primary dark:text-gray-100">
            📚 Artikel Terbaru
          </h2>
          <a href="/posts" class="font-medium text-primary hover:text-primary-hover">
            Lihat Semua →
          </a>
        </div>

        {/* Featured latest card - full width */}
        {latestPosts.length > 0 && (
          <div class="mb-8">
            <a
              href={`/posts/${latestPosts[0].slug}`}
              class="card card-elevated group block overflow-hidden md:grid md:grid-cols-2 md:gap-0"
            >
              {latestPosts[0].data.coverImage && (
                <div class="relative overflow-hidden">
                  <Image
                    src={latestPosts[0].data.coverImage}
                    alt={latestPosts[0].data.title}
                    width={600}
                    height={340}
                    loading="lazy"
                    class="h-56 w-full object-cover transition-transform duration-500 group-hover:scale-105 md:h-full"
                    style="aspect-ratio: 16/9;"
                  />
                  <div class="absolute top-3 left-3">
                    <span
                      class={`category-badge category-${getCategoryToken(latestPosts[0].data.category)}`}
                    >
                      {getCategoryLabel(latestPosts[0].data.category)}
                    </span>
                  </div>
                </div>
              )}
              <div class="flex flex-col justify-center p-6 md:p-8">
                <h3 class="mb-3 text-xl font-bold text-text-primary transition-colors group-hover:text-primary dark:text-gray-100 md:text-2xl">
                  {latestPosts[0].data.title}
                </h3>
                <p class="mb-4 text-text-secondary line-clamp-3 dark:text-gray-400">
                  {latestPosts[0].data.summary}
                </p>
                <div class="flex items-center gap-3 text-sm text-text-muted dark:text-gray-500">
                  <span>{latestPosts[0].data.author}</span>
                  <span>&bull;</span>
                  <time datetime={latestPosts[0].data.publishedAt.toISOString()}>
                    {new Date(latestPosts[0].data.publishedAt).toLocaleDateString('id-ID')}
                  </time>
                  {latestPosts[0].data.readingTime && (
                    <>
                      <span>&bull;</span>
                      <span>{latestPosts[0].data.readingTime} mnt baca</span>
                    </>
                  )}
                </div>
              </div>
            </a>
          </div>
        )}

        {/* Remaining articles in 3-column grid */}
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
          {latestPosts.slice(1).map((post) => <PostCard post={post} />)}
        </div>
      </div>
    </section>

    <!-- Trending: Numbered Ranking List -->
    <TrendingList posts={trendingPosts} />

    <!-- Editor's Picks -->
    <EditorsPicks posts={editorsPicks} />

    <!-- Newsletter CTA -->
    <NewsletterCTA />

    <!-- Tag Cloud Section -->
    <section
      class="border-t border-gray-200 bg-gray-50/50 py-16 dark:border-gray-800 dark:bg-gray-900/50"
    >
      <div class="container mx-auto px-4">
        <h2 class="mb-6 text-center text-2xl font-semibold text-text-primary dark:text-gray-100">
          🔖 Topik Populer
        </h2>
        <div class="flex flex-wrap justify-center gap-3">
          {
            allTags.slice(0, 20).map((tag) => (
              <a
                href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                class="rounded-full bg-surface px-4 py-2 text-sm font-medium transition-all duration-200 hover:scale-105 hover:bg-primary hover:text-white hover:shadow-md dark:bg-surface-dark"
              >
                #{tag}
              </a>
            ))
          }
        </div>
        {
          allTags.length > 20 && (
            <div class="mt-6 text-center">
              <a href="/tags" class="font-medium text-primary hover:text-primary-hover">
                Lihat semua {allTags.length} tag →
              </a>
            </div>
          )
        }
      </div>
    </section>
  </main>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
