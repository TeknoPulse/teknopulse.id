---
import Layout from '../layouts/Layout.astro';

const channels = [
  {
    label: 'Editorial',
    description: 'Tips berita, press release, koreksi, atau kolaborasi editorial.',
    email: 'redaksi@teknopulse.id',
  },
  {
    label: 'Pertanyaan umum',
    description: 'Pertanyaan tentang TeknoPulse dan masukan umum.',
    email: 'hello@teknopulse.id',
  },
  {
    label: 'Dukungan teknis',
    description: 'Masalah teknis dengan situs, RSS, atau pencarian.',
    email: 'support@teknopulse.id',
  },
];
---

<Layout
  title="Kontak — TeknoPulse"
  description="Hubungi redaksi TeknoPulse untuk tips berita, koreksi, kolaborasi editorial, atau pertanyaan teknis."
  showBreadcrumbs={false}
>
  <main>
    <header class="border-b-2 border-rule-strong">
      <div class="wrap pt-8 pb-7 sm:pt-12">
        <p class="kicker text-cobalt">Redaksi <span class="mx-1.5 text-rule">/</span> Kontak</p>
        <div class="mt-2 flex flex-wrap items-end justify-between gap-6">
          <h1
            class="font-serif text-[clamp(3.4rem,9vw,7rem)] font-semibold leading-[0.8] tracking-headline"
          >
            Kontak<span class="text-cobalt">.</span>
          </h1>
          <p class="max-w-sm pb-2 font-serif text-lg leading-snug text-ink-soft">
            Satu surel yang tepat lebih cepat sampai daripada formulir yang tidak terbaca siapa pun.
          </p>
        </div>
      </div>
    </header>

    <div class="wrap grid gap-12 py-10 sm:py-14 lg:grid-cols-12 lg:gap-0">
      <section class="lg:col-span-8 lg:pr-12" aria-labelledby="saluran">
        <h2
          id="saluran"
          class="border-b-2 border-rule-strong pb-2 font-serif text-2xl font-semibold"
        >
          Pilih saluran
        </h2>
        <div class="divide-y divide-rule">
          {
            channels.map((channel, index) => (
              <div class="grid gap-3 py-6 sm:grid-cols-[2.5rem_1fr_auto] sm:items-baseline sm:gap-6">
                <span class="font-display text-xl leading-none text-cobalt">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-serif text-xl font-semibold">{channel.label}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-ink-muted">{channel.description}</p>
                </div>
                <a
                  href={`mailto:${channel.email}`}
                  class="kicker text-cobalt hover:text-cobalt-dark"
                >
                  {channel.email}
                </a>
              </div>
            ))
          }
        </div>

        <div class="mt-8 border-l-2 border-cobalt pl-4">
          <p class="text-sm leading-relaxed text-ink-soft">
            Untuk koreksi artikel, sebutkan judul dan tautan artikelnya agar redaksi bisa menelusuri
            sumber dan memperbarui tulisan lebih cepat.
          </p>
        </div>
      </section>

      <aside class="lg:col-span-4 lg:border-l lg:border-rule lg:pl-10">
        <section aria-labelledby="waktu-respons">
          <h2
            id="waktu-respons"
            class="border-b-2 border-rule-strong pb-2 font-serif text-2xl font-semibold"
          >
            Waktu respons
          </h2>
          <dl class="divide-y divide-rule text-sm">
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="kicker text-ink-muted">Koreksi</dt>
              <dd class="text-right text-ink">1–2 hari kerja</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="kicker text-ink-muted">Tips berita</dt>
              <dd class="text-right text-ink">Sesuai prioritas</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="kicker text-ink-muted">Kolaborasi</dt>
              <dd class="text-right text-ink">3–5 hari kerja</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="kicker text-ink-muted">Teknis</dt>
              <dd class="text-right text-ink">1–2 hari kerja</dd>
            </div>
          </dl>
        </section>

        <section class="mt-8 border-t border-rule pt-5" aria-labelledby="tautan-kontak">
          <h2 id="tautan-kontak" class="kicker text-ink-muted">Lanjut membaca</h2>
          <ul class="mt-2 divide-y divide-rule">
            <li>
              <a href="/about/" class="block py-2.5 text-sm hover:text-cobalt">Tentang redaksi</a>
            </li>
            <li>
              <a href="/privacy-policy/" class="block py-2.5 text-sm hover:text-cobalt"
                >Kebijakan privasi</a
              >
            </li>
            <li>
              <a href="/posts/" class="block py-2.5 text-sm hover:text-cobalt">Arsip artikel</a>
            </li>
          </ul>
        </section>

        <p class="mt-8 border-l-2 border-cobalt pl-4 text-sm leading-relaxed text-ink-muted">
          TeknoPulse tidak menerima pembayaran untuk liputan atau tautan sponsor tanpa label yang
          jelas.
        </p>
      </aside>
    </div>
  </main>
</Layout>
