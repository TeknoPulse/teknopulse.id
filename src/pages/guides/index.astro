---
// src/pages/guides/index.astro
//
// Indeks semua panduan evergreen. Statik penuh: semua guide non-draft
// ditampilkan terurut terbaru — tidak ada filter.
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { getCategoryLabel, getCategoryUrl } from '../../utils/categories';
import { formatShortDate } from '../../utils/dates';
import { calculateReadingTime } from '../../utils/readingTime';
import { difficultyBadge } from '../../utils/difficulty';

const guides = (await getCollection('guides'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<Layout
  title="Panduan TeknoPulse"
  description="Koleksi panduan teknologi praktis untuk orang awam: AI, coding, tools, tips & trik. Dilengkapi langkah-langkah jelas, FAQ, dan checklist."
>
  <main>
    <header class="border-b-2 border-rule-strong">
      <div class="wrap pt-12 pb-8 sm:pt-16">
        <nav
          aria-label="Remah roti"
          class="kicker flex flex-wrap items-center gap-2 text-ink-muted"
        >
          <a href="/" class="hover:text-cobalt">Beranda</a>
          <span aria-hidden="true" class="text-rule">/</span>
          <span>Panduan</span>
        </nav>

        <h1
          class="headline-balance mt-5 font-serif text-[clamp(2.4rem,5.6vw,4.6rem)] font-semibold leading-[0.94] tracking-headline"
        >
          Panduan TeknoPulse
        </h1>

        <p class="mt-4 max-w-3xl font-serif text-xl italic leading-snug text-ink-soft sm:text-2xl">
          Panduan teknologi praktis untuk orang awam. AI, coding, tools, tips & trik — dilengkapi
          langkah-langkah jelas, FAQ, dan checklist biar kamu bisa langsung praktek.
        </p>
      </div>
    </header>

    <div class="wrap py-10 sm:py-14">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-0">
        <div class="lg:col-span-8 lg:pr-12">
          {
            guides.length > 0 ? (
              <>
                <p class="kicker mb-4 text-ink-muted" aria-live="polite">
                  {guides.length} panduan
                </p>
                <ul class="divide-y divide-rule" role="list" aria-label="Daftar panduan">
                  {guides.map((guide) => (
                    <li class="py-8">
                      <article class="group">
                        <p class="kicker flex items-center gap-2 text-cobalt">
                          <a
                            href={getCategoryUrl(guide.data.category)}
                            class="hover:text-cobalt-dark"
                          >
                            {getCategoryLabel(guide.data.category)}
                          </a>
                          <span class="mx-1.5 text-rule">/</span>
                          <time datetime={guide.data.publishedAt.toISOString()}>
                            {formatShortDate(guide.data.publishedAt)}
                          </time>
                          <span class="inline-flex items-center gap-1 rounded bg-amber-100 px-1.5 py-0.5 text-xs font-medium text-amber-800">
                            {difficultyBadge(guide.data.difficulty)}
                          </span>
                        </p>
                        <h2 class="mt-2 font-serif text-2xl font-semibold leading-snug transition-colors group-hover:text-cobalt">
                          <a href={`/guides/${guide.slug}/`}>{guide.data.title}</a>
                        </h2>
                        <p class="line-clamp-2 mt-3 text-sm leading-relaxed text-ink-muted">
                          {guide.data.description}
                        </p>
                        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-ink-muted">
                          <span>
                            {guide.data.readingTime ?? calculateReadingTime(guide.body)} menit baca
                          </span>
                          <span class="flex items-center gap-1">🎯 {guide.data.targetKeyword}</span>
                        </div>
                      </article>
                    </li>
                  ))}
                </ul>
              </>
            ) : (
              <div class="py-16 text-center">
                <p class="text-ink-muted">Belum ada panduan.</p>
              </div>
            )
          }
        </div>

        <aside class="lg:col-span-4 lg:border-l lg:border-rule lg:pl-10">
          <div class="lg:sticky lg:top-24">
            <section aria-labelledby="tentang-panduan">
              <div class="flex items-baseline justify-between border-b-2 border-rule-strong pb-2">
                <h2 id="tentang-panduan" class="font-serif text-2xl font-semibold">
                  Tentang Panduan
                </h2>
              </div>
              <p class="mt-4 text-sm leading-relaxed text-ink-muted">
                Panduan TeknoPulse dirancang untuk orang awam yang ingin belajar teknologi tanpa
                jargon membingungkan. Setiap panduan punya:
              </p>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-ink-muted">
                <li class="flex items-start gap-2">
                  <span class="text-cobalt">✓</span> TOC & TL;DR untuk navigasi cepat
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-cobalt">✓</span> Langkah-langkah step-by-step yang jelas
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-cobalt">✓</span> FAQ & Checklist ringkas di akhir
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-cobalt">✓</span> Voice hangat "aku" khas TeknoPulse
                </li>
              </ul>
            </section>
          </div>
        </aside>
      </div>
    </div>
  </main>
</Layout>
