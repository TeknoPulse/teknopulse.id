---
// src/pages/guides/[slug].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import GuidePage from '../../components/GuidePage.astro';

export const prerender = true;

export async function getStaticPaths() {
  // Draft tidak ikut di-build (selaras /posts): draft-guide.ts menulis
  // draft: true, jadi file draf tidak bocor jadi URL hidup.
  const guides = (await getCollection('guides')).filter(({ data }) => !data.draft);

  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: {
      guide,
      ogImage: guide.data.ogImage ?? guide.data.coverImage ?? `/og/${guide.slug}.png`,
    },
  }));
}

interface Props {
  guide: CollectionEntry<'guides'>;
  ogImage: CollectionEntry<'guides'>['data']['coverImage'] | string;
}

const { guide, ogImage } = Astro.props;
---

<GuidePage guide={guide} ogImage={ogImage} />
