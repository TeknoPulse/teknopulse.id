---
import Layout from '../../layouts/Layout.astro';
import DemoNotice from '../../components/DemoNotice.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { getIssueArticles, getTopic, topics, topicUrl } from '../../utils/edisi';
import type { Topic } from '../../utils/edisi';

export async function getStaticPaths() {
  return topics.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const articles = (await getIssueArticles()).filter((article) => article.data.topic === topic.slug);

const otherTopics = topics.filter((item) => item.slug !== topic.slug);
---

<Layout
  title={`${topic.label} — Topik TeknoPulse`}
  description={`${topic.description} Kumpulan artikel demo dari rubrik ${topic.label}.`}
  showBreadcrumbs={false}
>
  <DemoNotice compact />

  <header class="border-b-2 border-rule-strong">
    <div class="wrap pt-8 pb-7 sm:pt-10">
      <nav aria-label="Remah roti" class="kicker flex flex-wrap items-center gap-2 text-ink-muted">
        <a href="/topik/" class="hover:text-cobalt">Topik</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink">{topic.short}</span>
      </nav>

      <div class="mt-5 grid gap-6 sm:grid-cols-[1fr_auto] sm:items-end">
        <h1
          class="font-serif text-[clamp(2.8rem,7vw,5.6rem)] font-semibold leading-[0.88] tracking-headline"
        >
          {topic.label}
        </h1>
        <p class="kicker pb-2 text-ink-muted">{articles.length} tulisan · edisi demo</p>
      </div>
      <p class="mt-4 max-w-2xl font-serif text-xl leading-snug text-ink-soft">
        {topic.description}
      </p>
    </div>
  </header>

  <main class="wrap py-10 sm:py-14">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-0">
      <div class="lg:col-span-8 lg:pr-12">
        <div class="flex items-baseline justify-between border-b-2 border-rule-strong pb-2">
          <h2 class="font-serif text-2xl font-semibold">Semua tulisan</h2>
          <span class="kicker text-ink-muted">Terbaru lebih dulu</span>
        </div>
        <div>
          {
            articles.map((article, index) => (
              <ArticleRow article={article} index={index + 1} showIssue />
            ))
          }
        </div>
        {
          articles.length === 0 && (
            <p class="py-12 font-serif text-xl text-ink-muted">Belum ada tulisan di rubrik ini.</p>
          )
        }
      </div>

      <aside class="lg:col-span-4 lg:border-l lg:border-rule lg:pl-10">
        <section aria-labelledby="rubrik-lain">
          <h2 id="rubrik-lain" class="border-b border-rule pb-2 font-serif text-2xl font-semibold">
            Rubrik lain
          </h2>
          <ul class="divide-y divide-rule">
            {
              otherTopics.map((item) => (
                <li>
                  <a
                    href={topicUrl(item.slug)}
                    class="group flex items-baseline justify-between gap-4 py-3 hover:text-cobalt"
                  >
                    <span class="font-serif text-lg">{item.label}</span>
                    <span class="kicker text-ink-muted">{getTopic(item.slug).short}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-8 border-t border-rule pt-5" aria-labelledby="topik-cari">
          <h2 id="topik-cari" class="font-serif text-xl font-semibold">Cari artikel</h2>
          <form
            action="/cari/"
            method="get"
            role="search"
            class="mt-3 flex border-b border-rule-strong"
          >
            <label for="topic-search" class="sr-only">Cari artikel demo</label>
            <input
              id="topic-search"
              name="q"
              type="search"
              placeholder={`Cari di ${topic.label.toLowerCase()}…`}
              class="w-full min-w-0 bg-transparent py-2 text-sm text-ink placeholder:text-ink-muted"
            />
            <button type="submit" class="kicker px-2 text-cobalt hover:text-cobalt-dark"
              >Cari</button
            >
          </form>
          <p class="mt-4 text-sm leading-relaxed text-ink-muted">
            Simpan tulisan dengan tombol Baca nanti.
            <a href="/baca-nanti/" class="text-cobalt hover:text-cobalt-dark">Buka daftar →</a>
          </p>
        </section>

        <p class="mt-8 border-l-2 border-cobalt pl-4 text-sm leading-relaxed text-ink-muted">
          Rubrik ini berisi konten demo. Judul dan peristiwa tidak merujuk pada berita nyata.
        </p>
      </aside>
    </div>
  </main>
</Layout>
