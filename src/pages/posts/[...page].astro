---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import Pagination from '../../components/Pagination.astro';

export const prerender = true;

// Indeks artikel kanonik (/posts). Halaman 1 = /posts/, halaman n = /posts/n/ (sesuai pola Pagination).
// Route ini melayani tautan "Lihat Semua" di beranda & komponen lain (TEKAA-280).
export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('posts'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props;
const isPaginated = page.currentPage > 1;
const title = isPaginated ? `Semua Artikel — Halaman ${page.currentPage}` : 'Semua Artikel';
const description =
  'Arsip lengkap artikel TeknoPulse: berita teknologi, AI, gadget, dan panduan terbaru untuk pembaca Indonesia.';
// Halaman paginasi ≥2 tidak punya nilai unik: noindex, follow (selaras TEKAA-3 P1-8).
const robots = isPaginated ? 'noindex, follow' : 'index, follow';
---

<Layout title={title} description={description} robots={robots}>
  <main class="container mx-auto px-4 py-8">
    <div class="mb-8">
      <h1 class="mb-4 text-4xl font-bold">Semua Artikel</h1>
      <p class="text-gray-600 dark:text-gray-400">
        Arsip lengkap artikel TeknoPulse, terbaru di atas.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {page.data.map((post) => <PostCard post={post} />)}
    </div>

    <Pagination currentPage={page.currentPage} totalPages={page.lastPage} baseUrl="/posts" />
  </main>
</Layout>
