---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostRow from '../../components/PostRow.astro';
import Pagination from '../../components/Pagination.astro';

export const prerender = true;

// Indeks artikel kanonik (/posts). Halaman 1 = /posts/, halaman n = /posts/n/ (sesuai pola Pagination).
// Route ini melayani tautan "Lihat Semua" di beranda & komponen lain (TEKAA-280).
export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('posts'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

  return paginate(posts, { pageSize: 12 });
}

const { page } = Astro.props;
const isPaginated = page.currentPage > 1;
const title = isPaginated ? `Semua Artikel — Halaman ${page.currentPage}` : 'Semua Artikel';
const description =
  'Arsip lengkap artikel TeknoPulse: berita teknologi, AI, gadget, dan panduan terbaru untuk pembaca Indonesia.';
// Halaman paginasi ≥2 tidak punya nilai unik: noindex, follow (selaras TEKAA-3 P1-8).
const robots = isPaginated ? 'noindex, follow' : 'index, follow';
const startIndex = (page.currentPage - 1) * page.size;
---

<Layout title={title} description={description} robots={robots} showBreadcrumbs={false}>
  <header class="border-b-2 border-rule-strong">
    <div class="wrap pt-8 pb-7 sm:pt-12">
      <p class="kicker text-cobalt">
        Arsip terbuka
        {isPaginated && <span class="text-ink-muted"> / Halaman {page.currentPage}</span>}
      </p>
      <div class="mt-2 flex flex-wrap items-end justify-between gap-6">
        <h1
          class="font-serif text-[clamp(3rem,9vw,7rem)] font-semibold leading-[0.8] tracking-headline"
        >
          Semua artikel<span class="text-cobalt">.</span>
        </h1>
        <p class="max-w-sm pb-2 font-serif text-lg leading-snug text-ink-soft">
          Arsip lengkap TeknoPulse, terbaru di atas. {page.total} tulisan dari seluruh rubrik.
        </p>
      </div>
      <div class="mt-5 flex flex-wrap items-baseline gap-x-5 gap-y-1 border-t border-rule pt-3">
        <span class="kicker text-ink-muted">{page.total} artikel</span>
        <span class="kicker text-ink-muted">Halaman {page.currentPage} dari {page.lastPage}</span>
        <a href="/category/" class="kicker ml-auto text-cobalt hover:text-cobalt-dark">
          Jelajahi rubrik →
        </a>
      </div>
    </div>
  </header>

  <main class="wrap py-8 sm:py-10">
    <div>
      {
        page.data.map((post, index) => (
          <PostRow post={post} index={startIndex + index + 1} thumbnail />
        ))
      }
    </div>

    <Pagination currentPage={page.currentPage} totalPages={page.lastPage} baseUrl="/posts/" />
  </main>
</Layout>
