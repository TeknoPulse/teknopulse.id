---
// src/pages/posts/[slug].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { calculateReadingTime } from '../../utils/readingTime';
import { getAuthor, getAuthorUrl } from '../../utils/authors';
import ShareButtons from '../../components/ShareButtons.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { Image } from 'astro:assets';

// ✅ Wajib: agar getStaticPaths() jalan
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts');

  // og:image harus unik per artikel (TEKAA-5): coverImage yang dipakai
  // bersama oleh ≥2 artikel tidak boleh jadi og:image — ganti dengan kartu
  // OG hasil generate `/og/<slug>.png` yang unik per slug.
  const coverUsage = new Map<string, number>();
  for (const p of posts) {
    const src = p.data.coverImage?.src;
    if (src) coverUsage.set(src, (coverUsage.get(src) ?? 0) + 1);
  }

  return posts.map((post) => {
    const coverSrc = post.data.coverImage?.src;
    const coverShared = !!coverSrc && (coverUsage.get(coverSrc) ?? 0) > 1;
    const ogImage =
      post.data.ogImage ??
      (post.data.coverImage && !coverShared ? post.data.coverImage : `/og/${post.slug}.png`);
    return { params: { slug: post.slug }, props: { post, ogImage } };
  });
}

interface Props {
  post: CollectionEntry<'posts'>;
  ogImage: CollectionEntry<'posts'>['data']['coverImage'] | string;
}

const { post, ogImage } = Astro.props;

if (!post) {
  return Astro.redirect('/404');
}

// ✅ Render konten Markdown
const { Content } = await post.render();

// Hitung waktu baca (fallback ke perhitungan dari isi bila frontmatter kosong)
const readingTime = post.data.readingTime ?? calculateReadingTime(post.body);

// Penulis terdaftar → byline jadi tautan ke halaman profil + author.url JSON-LD
const author = getAuthor(post.data.author);

// Meta description dikelola per artikel (120–155 karakter); fallback ke summary
const description = post.data.metaDescription ?? post.data.summary;

// Tanggal pembaruan hanya ditampilkan bila beda hari dari tanggal terbit
const updated =
  post.data.updatedAt &&
  post.data.updatedAt.toISOString().slice(0, 10) !==
    post.data.publishedAt.toISOString().slice(0, 10)
    ? post.data.updatedAt
    : undefined;

// Ambil postingan terkait berdasarkan tag, urut terbaru (TEKAA-3 P0-5).
// Fallback: kalau tidak ada yang se-tag, pakai artikel terbaru lain supaya
// setiap artikel selalu punya tautan internal di dalam konten.
const allPosts = await getCollection('posts');
const otherPosts = allPosts
  .filter((p) => p.slug !== post.slug && !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const tagRelated = otherPosts.filter((p) =>
  (p.data.tags ?? []).some((tag) => (post.data.tags ?? []).includes(tag))
);
const relatedPosts = (tagRelated.length > 0 ? tagRelated : otherPosts).slice(0, 3);

const faq = post.data.faq ?? [];
---

<Layout
  title={post.data.title}
  description={description}
  image={ogImage}
  imageAlt={post.data.title}
  article={{
    publishedTime: post.data.publishedAt.toISOString(),
    modifiedTime: post.data.updatedAt?.toISOString(),
    author: {
      name: author?.name ?? post.data.author,
      url: author ? getAuthorUrl(author) : undefined,
    },
    tags: post.data.tags,
    category: post.data.category,
    faq,
  }}
  postCategory={post.data.category}
  postTitle={post.data.title}
>
  <main class="container mx-auto px-4 py-8">
    <article class="mx-auto max-w-4xl">
      <header class="mb-8">
        {
          post.data.coverImage && (
            <Image
              src={post.data.coverImage}
              alt={post.data.title}
              width={1024}
              height={426}
              loading="eager"
              fetchpriority="high"
              class="mb-6 h-64 w-full rounded-lg object-cover"
            />
          )
        }

        <h1 class="mb-4 text-4xl font-bold">{post.data.title}</h1>

        <div class="mb-4 flex flex-wrap items-center text-sm text-gray-600 dark:text-gray-400">
          <span>
            Oleh
            {
              author ? (
                <a href={getAuthorUrl(author)} class="hover:text-primary hover:underline">
                  {author.name}
                </a>
              ) : (
                <span>{post.data.author}</span>
              )
            }
          </span>
          <span class="mx-2">•</span>
          <time datetime={post.data.publishedAt.toISOString()}>
            {new Date(post.data.publishedAt).toLocaleDateString('id-ID')}
          </time>
          {
            updated && (
              <>
                <span class="mx-2">•</span>
                <span>
                  Diperbarui{' '}
                  <time datetime={updated.toISOString()}>
                    {new Date(updated).toLocaleDateString('id-ID')}
                  </time>
                </span>
              </>
            )
          }
          <span class="mx-2">•</span>
          <span>{readingTime} mnt baca</span>
        </div>

        <div class="mb-6 flex flex-wrap gap-2">
          {
            post.data.tags?.map((tag) => (
              <a
                href={`/tags/${tag.toLowerCase().replace(/\s+/g, '-')}`}
                class="rounded-full bg-blue-100 px-3 py-1 text-sm text-blue-800 dark:bg-blue-900 dark:text-blue-200"
              >
                {tag}
              </a>
            ))
          }
        </div>
      </header>

      <div class="prose prose-lg max-w-none dark:prose-invert">
        <Content />
      </div>

      {
        faq.length > 0 && (
          <section class="mt-10" aria-labelledby="faq-heading">
            <h2 id="faq-heading" class="mb-4 text-2xl font-bold">
              Pertanyaan yang Sering Diajukan
            </h2>
            <div class="space-y-6">
              {faq.map((item) => (
                <div>
                  <h3 class="text-lg font-semibold">{item.question}</h3>
                  <p class="mt-1 text-gray-700 dark:text-gray-300">{item.answer}</p>
                </div>
              ))}
            </div>
          </section>
        )
      }

      <ShareButtons title={post.data.title} url={`/posts/${post.slug}`} />

      {
        relatedPosts.length > 0 && (
          <section class="mt-12">
            <h2 class="mb-6 text-2xl font-bold">Artikel Terkait</h2>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
              {relatedPosts.map((relatedPost) => (
                <a
                  href={`/posts/${relatedPost.slug}`}
                  class="block rounded-lg border p-4 transition-shadow hover:shadow-md"
                >
                  <h3 class="mb-2 font-semibold">{relatedPost.data.title}</h3>
                  <p class="text-sm text-gray-600 dark:text-gray-400">{relatedPost.data.summary}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <GiscusComments />
    </article>
  </main>
</Layout>
