---
// src/pages/posts/[slug].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import ArticlePage from '../../components/ArticlePage.astro';
import { getCategoryPosts, getRelatedPosts, sortPosts } from '../../utils/related';

// ✅ Wajib: agar getStaticPaths() jalan
export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);

  // Sort once for related posts calculation
  const sortedPosts = sortPosts(posts);

  // og:image harus unik per artikel (TEKAA-5): coverImage yang dipakai
  // bersama oleh ≥2 artikel tidak boleh jadi og:image — ganti dengan kartu
  // OG hasil generate `/og/<slug>.png` yang unik per slug.
  const coverUsage = new Map<string, number>();
  for (const p of posts) {
    const src = p.data.coverImage?.src;
    if (src) coverUsage.set(src, (coverUsage.get(src) ?? 0) + 1);
  }

  return posts.map((post) => {
    const coverSrc = post.data.coverImage?.src;
    const coverShared = !!coverSrc && (coverUsage.get(coverSrc) ?? 0) > 1;
    const ogImage =
      post.data.ogImage ??
      (post.data.coverImage && !coverShared ? post.data.coverImage : `/og/${post.slug}.png`);

    return {
      params: { slug: post.slug },
      props: {
        post,
        ogImage,
        relatedPosts: getRelatedPosts(post, sortedPosts),
        categoryPosts: getCategoryPosts(post, sortedPosts),
      },
    };
  });
}

interface Props {
  post: CollectionEntry<'posts'>;
  ogImage: CollectionEntry<'posts'>['data']['coverImage'] | string;
  relatedPosts: CollectionEntry<'posts'>[];
  categoryPosts: CollectionEntry<'posts'>[];
}

const { post, ogImage, relatedPosts, categoryPosts } = Astro.props;
---

<ArticlePage
  post={post}
  ogImage={ogImage}
  relatedPosts={relatedPosts}
  categoryPosts={categoryPosts}
/>
